// Electrical-check example; simplified pin models, not a fabrication design.
from noscheme import role, nettype
from noscheme import bias
// Pull models only the bus-side electrical contribution of a pull-up.
// Its supply terminal is omitted for this registry demonstration. For a real
// two-terminal resistor, see I2CPullup in ../stm32h523/components.nosch and
// its instances connecting pin 1 to v3v3 in ../stm32h523/stm32h523.nosch.
component Pull:
    pins:
        1:
            role: role.passive
            bias: bias.pull_up
            pull_resistance_ohm: 4700
            capacitance_pF: 2
component Device:
    pins:
        1:
            role: role.open_drain
            bias: bias.none
            capacitance_pF: 10
board B:
    net bus: nettype.open_drain
        checks:
            pin_count:
                checker: "demo.pin_count"
                params:
                    max_pins: 3
            pull_up:
                checker: "std.reduce"
                params:
                    attribute: "pull_resistance_ohm"
                    reducer: "std.parallel"
                    where:
                        bias: bias.pull_up
                    min: 2000
                    max: 5000
            capacitance:
                checker: "std.reduce"
                params:
                    attribute: "capacitance_pF"
                    reducer: "std.sum"
                    net_attributes: ["wiring_capacitance_pF"]
                    max: 20
        wiring_capacitance_pF: 2
    inst pull[2]: Pull(
        connections:
            1: bus
    )
    inst device: Device(
        connections:
            1: bus
    )
