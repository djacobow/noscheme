// Five-part circuit used to validate compilation and the KiCad exporter.
from noscheme import nettype
from parts import Header
from indicator import Indicator

board Blink:
    global net gnd: nettype.ground
    global net v5: nettype.power
    inst input: Header(
        connections:
            1: global.v5
            2: global.gnd
    )
    inst indicators[2]: Indicator(
        connections:
            supply: global.v5
    )
