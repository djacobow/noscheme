// Five-part circuit used to validate compilation and the KiCad exporter.
from noscheme import net, role
from parts import Header
from indicator import Indicator

board Blink:
  global net.ground gnd
  global net.power v5
  Header input:
    1: global.v5
    2: global.gnd
    metadata:
      pins:
        1: role.power_output
        2: role.ground
  Indicator indicators[2](supply: global.v5)
