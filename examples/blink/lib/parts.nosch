from noscheme import role, use

component Resistor:
  params:
    resistance value
  pins:
    1..2: [role.passive, use.required]
  metadata:
    ref_prefix: "R"
    interchangeable: [1, 2]
    footprint: "Resistor_SMD:R_0603_1608Metric"

component Led:
  params:
    string value = "Green"
  pins:
    1 (cathode):
      role: role.passive
      use: use.required
    2 (anode):
      role: role.passive
      use: use.required
  metadata:
    ref_prefix: "D"
    footprint: "LED_SMD:LED_0603_1608Metric"

component Header:
  pins:
    1..2: use.explicit
  metadata:
    ref_prefix: "J"
    footprint: "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical"
