/*
STM32H523VCT6 proof-of-concept board, LQFP100.

All parts now have physical pin maps and footprints. This is a placement/routing
example, not a production-qualified design. See docs/PROJECT.md for source references
and pin allocation. USB and external power are operator-controlled: no reverse
feed protection or automatic source selection is provided.

Hardware follow-up: tune the 8 MHz HC49 crystal's provisional 27 pF load caps;
verify capacitor effective capacitance and regulator thermal headroom after
layout; configure MCU alternate functions, USB clocking, and boot option bytes.
Use the placement notes on decoupling capacitors during PCB layout. All small
resistors/capacitors use 0603. No unverified current capacities are annotated.
*/

from noscheme import role, net, pull, drive
from interfaces import I2C, SPI, USB2, SWD
from components import I2CPullup, InputPullup0603, InputPulldown0603, Capacitor0603
from components import PushButton, Indicator
from components import Header1x2, Header1x4, Header2x10, UartHeaderJST3
import mcu
import peripherals

block STM32H523Reference:
  metadata:
    erc_choices:
      power_source: ["usb", "header5v"]
    configurations:
      usb_powered:
        power_source: "usb"
      header_5v_powered:
        power_source: "header5v"
  global net.ground gnd
  global net.power v5
  global net.power v3v3

  USB2 usb
  SWD debug
  SPI sd
  net.digital sd_detect#
  I2C oled
  I2C expansion_i2c
  SPI expansion_spi
  net.bidirectional expansion_gpio[10]
  net.digital led_drive[3]
  net.digital buttons#[2]
  net.digital boot0
  net.digital uart_tx[2]
  net.digital uart_rx[2]

  mcu.MCU_H523 mcu(
    supply: global.v3v3,
    ground: global.gnd,
    usb: usb,
    debug: debug,
    sd: sd,
    sd_detect#: sd_detect#,
    oled: oled,
    expansion_i2c: expansion_i2c,
    expansion_spi: expansion_spi,
    expansion_gpio: expansion_gpio,
    led_drive: led_drive,
    buttons#: buttons#,
    boot0: boot0,
    uart_tx: uart_tx,
    uart_rx: uart_rx,
  )

  peripherals.UsbC usb_c:
    vbus: global.v5
    ground: global.gnd
    data: usb
    metadata:
      erc_choices:
        power_mode: choice(power_source, usb="source", header5v="absent")

  peripherals.Ldo3v3 regulator(input: global.v5, output: global.v3v3, ground: global.gnd)

  peripherals.MicroSD micro_sd(
    supply: global.v3v3,
    ground: global.gnd,
    bus: sd,
    detect#: sd_detect#,
  )

  peripherals.CortexDebug swd(reference: global.v3v3, ground: global.gnd, debug: debug)

  // OLED header order: 3.3 V, ground, SCL, SDA; match the module cable to it.
  Capacitor0603<100n> oled_decouple:
    1: global.v3v3
    2: global.gnd
    metadata:
      custom:
        placement: "Place beside display header supply pin."
  Capacitor0603<4.7u> oled_bulk(global.v3v3, global.gnd)

  Header1x4 oled_header:
    1: global.v3v3
    2: global.gnd
    3: oled.scl
    4: oled.sda
    metadata:
      pins:
        1: role.power_input
        2: role.ground
        // Assumes the display module adds no pull-ups; model them here if it does.
        3: [drive.low, pull.none]
        4: [drive.low, pull.none]

  I2CPullup oled_scl_pullup(1: global.v3v3, 2: oled.scl)
  I2CPullup oled_sda_pullup(1: global.v3v3, 2: oled.sda)
  // Bias is explicitly modeled; check whether the chosen OLED module already
  // has pullups. Choose net resistance/capacitance limits after hardware review.

  // Illustrative header order: 4 power/ground + 2 I2C + 4 SPI + 10 other GPIO.
  // Bus pins are also GPIO-capable MCU pins, giving 16 GPIO connections total.
  Header2x10 expansion:
    1: global.gnd
    2: global.gnd
    3: global.v5
    4: global.v3v3
    5: expansion_i2c.scl
    6: expansion_i2c.sda
    7: expansion_spi.sck
    8: expansion_spi.mosi
    9: expansion_spi.miso
    10: expansion_spi.cs#
    11..20: expansion_gpio[0:10]
    metadata:
      pins:
        1: role.ground
        2: role.ground
        3: choice(power_source, usb=role.power_input, header5v=role.power_output)
        4: role.power_input
        // Assumes expansion devices add no I2C pull-ups of their own.
        5: [drive.low, pull.none]
        6: [drive.low, pull.none]
        7: role.digital_input
        8: role.digital_input
        9: role.digital_output
        10: role.digital_input
        11..20: role.digital_bidirectional
  // Connector roles above describe the external equipment's endpoints.
  // Example SPI roles assume the board is controller; other uses need ERC configurations.
  I2CPullup expansion_scl_pullup(1: global.v3v3, 2: expansion_i2c.scl)
  I2CPullup expansion_sda_pullup(1: global.v3v3, 2: expansion_i2c.sda)

  // TX/RX are named from the MCU's perspective. Each header gets its own UART.
  UartHeaderJST3 uart_headers[2]:
    gnd: global.gnd
    tx: uart_tx
    rx: uart_rx
    metadata:
      pins:
        1: role.ground
        2: role.digital_input
        3: role.digital_output

  // Two active-low buttons with independent pull-ups and common ground.
  PushButton buttons[2](buttons#, global.gnd)
  InputPullup0603 button_pullups[2](1: global.v3v3, 2: buttons#)
  // NRST uses the MCU internal pull-up and the existing 100 nF reset capacitor.
  PushButton reset_button(debug.reset#, global.gnd)

  // Shunt installed: BOOT0 high. Shunt absent: resistor pulls BOOT0 low.
  Header1x2 boot_header(1: global.v3v3, 2: boot0)
  InputPulldown0603 boot_pulldown(1: boot0, 2: global.gnd)
  // Bias annotations are explicit; passive parts alone do not imply propagation.

  Indicator indicators[3]:
    [0].drive: led_drive[0]
    [1].drive: led_drive[1]
    [2].drive: led_drive[2]
  // Equivalent whole-array binding: drive: led_drive.
  // Use one form or the other; overlapping bindings are errors.

  // USB and header-5V configurations check the same direct physical rails.
  // External 3.3 V operation remains an operator-controlled experiment;
  // there is no LDO isolation and no model for a deliberately unpowered v5 rail.
