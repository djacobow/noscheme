/*
STM32H523VCT6 proof-of-concept board, LQFP100.

All parts now have physical pin maps and footprints. This is a placement/routing
example, not a production-qualified design. See docs/PROJECT.md for source references
and pin allocation. USB and external power are operator-controlled: no reverse
feed protection or automatic source selection is provided.

Hardware follow-up: tune the 8 MHz HC49 crystal's provisional 27 pF load caps;
verify capacitor effective capacitance and regulator thermal headroom after
layout; configure MCU alternate functions, USB clocking, and boot option bytes.
Use the placement notes on decoupling capacitors during PCB layout. All small
resistors/capacitors use 0603. No unverified current capacities are annotated.
*/

from noscheme import role, nettype, bias
from stm32h523_interfaces import I2C, SPI, USB2, SWD
from stm32h523_components import I2CPullup, InputBias0603, Capacitor0603
from stm32h523_components import PushButton, Indicator
from stm32h523_components import Header1x2, Header1x4, Header2x10, UartHeaderJST3
import stm32h523_mcu
import stm32h523_peripherals

board STM32H523Reference:
    metadata:
        erc_choices:
            power_source: ["usb", "header5v"]
        configurations:
            usb_powered:
                power_source: "usb"
            header_5v_powered:
                power_source: "header5v"
    global net gnd: nettype.ground
    global net v5: nettype.power
    global net v3v3: nettype.power

    net usb: USB2
    net debug: SWD
    net sd: SPI
    net sd_detect#: nettype.digital
    net oled: I2C
    net expansion_i2c: I2C
    net expansion_spi: SPI
    net expansion_gpio: nettype.bidirectional[10]
    net led_drive: nettype.digital[3]
    net buttons#: nettype.digital[2]
    net boot0: nettype.digital
    net uart_tx: nettype.digital[2]
    net uart_rx: nettype.digital[2]

    inst mcu: stm32h523_mcu.MCU_H523(
        connections:
            supply: global.v3v3
            ground: global.gnd
            usb: usb
            debug: debug
            sd: sd
            sd_detect#: sd_detect#
            oled: oled
            expansion_i2c: expansion_i2c
            expansion_spi: expansion_spi
            expansion_gpio: expansion_gpio
            led_drive: led_drive
            buttons#: buttons#
            boot0: boot0
            uart_tx: uart_tx
            uart_rx: uart_rx
    )

    inst usb_c: stm32h523_peripherals.UsbC(
        connections:
            vbus: global.v5
            ground: global.gnd
            data: usb
        metadata:
            erc_choices:
                power_mode:
                    choice: "power_source"
                    cases:
                        usb: "source"
                        header5v: "absent"
    )

    inst regulator: stm32h523_peripherals.Ldo3v3(
        connections:
            input: global.v5
            output: global.v3v3
            ground: global.gnd
    )

    inst micro_sd: stm32h523_peripherals.MicroSD(
        connections:
            supply: global.v3v3
            ground: global.gnd
            bus: sd
            detect#: sd_detect#
    )

    inst swd: stm32h523_peripherals.CortexDebug(
        connections:
            reference: global.v3v3
            ground: global.gnd
            debug: debug
    )

    // OLED header order: 3.3 V, ground, SCL, SDA; match the module cable to it.
    inst oled_decouple: Capacitor0603(
        connections:
            1: global.v3v3
            2: global.gnd
        params:
            value: "100nF"
        metadata:
            custom:
                placement: "Place beside display header supply pin."
    )
    inst oled_bulk: Capacitor0603(
        connections:
            1: global.v3v3
            2: global.gnd
        params:
            value: "4.7uF"
    )

    inst oled_header: Header1x4(
        connections:
            1: global.v3v3
            2: global.gnd
            3: oled.scl
            4: oled.sda
        metadata:
            pins:
                1:
                    external_role: role.power_input
                2:
                    external_role: role.ground
                3:
                    external_role: role.open_drain
                4:
                    external_role: role.open_drain
    )

    inst oled_scl_pullup: I2CPullup(
        connections:
            1: global.v3v3
            2: oled.scl
    )
    inst oled_sda_pullup: I2CPullup(
        connections:
            1: global.v3v3
            2: oled.sda
    )
    // Bias is explicitly modeled; check whether the chosen OLED module already
    // has pullups. Choose net resistance/capacitance limits after hardware review.

    // Illustrative header order: 4 power/ground + 2 I2C + 4 SPI + 10 other GPIO.
    // Bus pins are also GPIO-capable MCU pins, giving 16 GPIO connections total.
    inst expansion: Header2x10(
        connections:
            1: global.gnd
            2: global.gnd
            3: global.v5
            4: global.v3v3
            5: expansion_i2c.scl
            6: expansion_i2c.sda
            7: expansion_spi.sck
            8: expansion_spi.mosi
            9: expansion_spi.miso
            10: expansion_spi.cs#
            11..20: expansion_gpio[0:10]
        metadata:
            pins:
                1:
                    external_role: role.ground
                2:
                    external_role: role.ground
                3:
                    external_role:
                        choice: "power_source"
                        cases:
                            usb: role.power_input
                            header5v: role.power_output
                4:
                    external_role: role.power_input
                5:
                    external_role: role.open_drain
                6:
                    external_role: role.open_drain
                7:
                    external_role: role.digital_input
                8:
                    external_role: role.digital_input
                9:
                    external_role: role.digital_output
                10:
                    external_role: role.digital_input
                11..20:
                    external_role: role.digital_bidirectional
    )
    // Connector roles above describe the external equipment's endpoints.
    // Example SPI roles assume the board is controller; other uses need ERC configurations.
    inst expansion_scl_pullup: I2CPullup(
        connections:
            1: global.v3v3
            2: expansion_i2c.scl
    )
    inst expansion_sda_pullup: I2CPullup(
        connections:
            1: global.v3v3
            2: expansion_i2c.sda
    )

    // TX/RX are named from the MCU's perspective. Each header gets its own UART.
    inst uart_headers[2]: UartHeaderJST3(
        connections:
            gnd: global.gnd
            tx: uart_tx
            rx: uart_rx
        metadata:
            pins:
                1:
                    external_role: role.ground
                2:
                    external_role: role.digital_input
                3:
                    external_role: role.digital_output
    )

    // Two active-low buttons with independent pull-ups and common ground.
    inst buttons[2]: PushButton(
        connections:
            signal: buttons#
            ground: global.gnd
    )
    inst button_pullups[2]: InputBias0603(
        connections:
            1: global.v3v3
            2: buttons#
        metadata:
            pins:
                2:
                    bias: bias.pull_up
                    pull_resistance_ohm: 10000
    )
    // NRST uses the MCU internal pull-up and the existing 100 nF reset capacitor.
    inst reset_button: PushButton(
        connections:
            signal: debug.reset#
            ground: global.gnd
    )

    // Shunt installed: BOOT0 high. Shunt absent: resistor pulls BOOT0 low.
    inst boot_header: Header1x2(
        connections:
            1: global.v3v3
            2: boot0
    )
    inst boot_pulldown: InputBias0603(
        connections:
            1: boot0
            2: global.gnd
        metadata:
            pins:
                1:
                    bias: bias.pull_down
                    pull_resistance_ohm: 10000
    )
    // Bias annotations are explicit; passive parts alone do not imply propagation.

    inst indicators[3]: Indicator(
        connections:
            [0].drive: led_drive[0]
            [1].drive: led_drive[1]
            [2].drive: led_drive[2]
    )
    // Equivalent whole-array binding: drive: led_drive.
    // Use one form or the other; overlapping bindings are errors.

    // USB and header-5V configurations check the same direct physical rails.
    // External 3.3 V operation remains an operator-controlled experiment;
    // there is no LDO isolation and no model for a deliberately unpowered v5 rail.
