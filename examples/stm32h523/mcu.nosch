// STM32H523 pin roles, decoupling, crystal, and public subsystem interface.

from noscheme import role, nettype, unused
from parts import STM32H523VCTx
from interfaces import I2C, SPI, USB2, SWD
from components import Capacitor0603, CrystalHC49

component STM32H523Board extends STM32H523VCTx:
    defaults:
        value: "STM32H523VCT6"
    pins:
        1:
            role: role.digital_bidirectional
            unused: unused.never
        2:
            role: role.digital_bidirectional
            unused: unused.never
        3:
            role: role.digital_bidirectional
            unused: unused.never
        4:
            role: role.digital_bidirectional
            unused: unused.never
        5:
            role: role.digital_bidirectional
            unused: unused.never
        6:
            role: role.power_input
            unused: unused.never
        10:
            role: role.ground
            unused: unused.never
        11:
            role: role.power_input
            unused: unused.never
        12:
            role: role.analog_input
            unused: unused.never
        13:
            role: role.analog_output
            unused: unused.never
        14:
            role: role.open_drain
            unused: unused.never
        15:
            role: role.digital_output
            unused: unused.never
        16:
            role: role.digital_output
            unused: unused.never
        17:
            role: role.digital_output
            unused: unused.never
        18:
            role: role.digital_input
            unused: unused.never
        19:
            role: role.ground
            unused: unused.never
        20:
            role: role.ground
            unused: unused.never
        21:
            role: role.power_input
            unused: unused.never
        22:
            role: role.power_input
            unused: unused.never
        25:
            role: role.digital_output
            unused: unused.never
        26:
            role: role.digital_input
            unused: unused.never
        27:
            role: role.ground
            unused: unused.never
        28:
            role: role.power_input
            unused: unused.never
        29:
            role: role.digital_output
            unused: unused.never
        30:
            role: role.digital_output
            unused: unused.never
        31:
            role: role.digital_input
            unused: unused.never
        32:
            role: role.digital_output
            unused: unused.never
        33:
            role: role.digital_input
            unused: unused.never
        34:
            role: role.digital_input
            unused: unused.never
        38:
            role: role.digital_bidirectional
            unused: unused.never
        39:
            role: role.digital_bidirectional
            unused: unused.never
        40:
            role: role.digital_bidirectional
            unused: unused.never
        41:
            role: role.digital_bidirectional
            unused: unused.never
        42:
            role: role.digital_output
            unused: unused.never
        43:
            role: role.digital_output
            unused: unused.never
        44:
            role: role.digital_input
            unused: unused.never
        45:
            role: role.digital_output
            unused: unused.never
        46:
            role: role.digital_bidirectional
            unused: unused.never
        48:
            role: role.power_output
            unused: unused.never
        49:
            role: role.ground
            unused: unused.never
        50:
            role: role.power_input
            unused: unused.never
        55:
            role: role.digital_output
            unused: unused.never
        56:
            role: role.digital_input
            unused: unused.never
        66:
            role: role.open_drain
            unused: unused.never
        67:
            role: role.open_drain
            unused: unused.never
        70:
            role: role.digital_bidirectional
            unused: unused.never
        71:
            role: role.digital_bidirectional
            unused: unused.never
        72:
            role: role.digital_bidirectional
            unused: unused.never
        73:
            role: role.power_input
            unused: unused.never
        74:
            role: role.ground
            unused: unused.never
        75:
            role: role.power_input
            unused: unused.never
        76:
            role: role.digital_input
            unused: unused.never
        89:
            role: role.digital_output
            unused: unused.never
        92:
            role: role.open_drain
            unused: unused.never
        93:
            role: role.open_drain
            unused: unused.never
        94:
            role: role.digital_input
            unused: unused.never
        98:
            role: role.power_output
            unused: unused.never
        99:
            role: role.ground
            unused: unused.never
        100:
            role: role.power_input
            unused: unused.never
// Concrete reference-board implementations.
// Sources and pin allocation are recorded in docs/PROJECT.md.
// These blocks expose logical interfaces over explicit physical pins.
// Support parts are explicitly instantiated inside each block.
block MCU_H523:
    ports:
        supply: nettype.power
        ground: nettype.ground
        usb: USB2
        debug: SWD
        sd: SPI
        sd_detect#: nettype.digital
        oled: I2C
        expansion_i2c: I2C
        expansion_spi: SPI
        expansion_gpio: nettype.bidirectional[10]
        led_drive: nettype.digital[3]
        buttons#: nettype.digital[2]
        boot0: nettype.digital
        uart_tx: nettype.digital[2]
        uart_rx: nettype.digital[2]
    metadata:
        custom:
            intended_mcu: "STM32H523VCT6"
            intended_package: "LQFP-100"

    net osc_in: nettype.analog
    net osc_out: nettype.analog
    net vcap: nettype.power
        waivers:
            multiple_drivers: "VCAP pins 48 and 98 belong to the same internal regulator (AN5711)."
    inst chip: STM32H523Board(
        connections:
            1: expansion_gpio[0]
            2: expansion_gpio[1]
            3: expansion_gpio[2]
            4: expansion_gpio[3]
            5: expansion_gpio[4]
            6: supply
            7: no_connect
            8: no_connect
            9: no_connect
            10: ground
            11: supply
            12: osc_in
            13: osc_out
            14: debug.reset#
            15: led_drive[0]
            16: led_drive[1]
            17: led_drive[2]
            18: sd_detect#
            19: ground
            20: ground
            21: supply
            22: supply
            23: no_connect
            24: no_connect
            25: uart_tx[0]
            26: uart_rx[0]
            27: ground
            28: supply
            29: sd.cs#
            30: sd.sck
            31: sd.miso
            32: sd.mosi
            33: buttons#[0]
            34: buttons#[1]
            35: no_connect
            36: no_connect
            37: no_connect
            38: expansion_gpio[5]
            39: expansion_gpio[6]
            40: expansion_gpio[7]
            41: expansion_gpio[8]
            42: expansion_spi.cs#
            43: expansion_spi.sck
            44: expansion_spi.miso
            45: expansion_spi.mosi
            46: expansion_gpio[9]
            47: no_connect
            48: vcap
            49: ground
            50: supply
            51: no_connect
            52: no_connect
            53: no_connect
            54: no_connect
            55: uart_tx[1]
            56: uart_rx[1]
            57: no_connect
            58: no_connect
            59: no_connect
            60: no_connect
            61: no_connect
            62: no_connect
            63: no_connect
            64: no_connect
            65: no_connect
            66: expansion_i2c.sda
            67: expansion_i2c.scl
            68: no_connect
            69: no_connect
            70: usb.dm
            71: usb.dp
            72: debug.swdio
            73: supply
            74: ground
            75: supply
            76: debug.swclk
            77: no_connect
            78: no_connect
            79: no_connect
            80: no_connect
            81: no_connect
            82: no_connect
            83: no_connect
            84: no_connect
            85: no_connect
            86: no_connect
            87: no_connect
            88: no_connect
            89: debug.swo
            90: no_connect
            91: no_connect
            92: oled.scl
            93: oled.sda
            94: boot0
            95: no_connect
            96: no_connect
            97: no_connect
            98: vcap
            99: ground
            100: supply
    )
    inst decouple_pin_6: Capacitor0603(
        connections:
            1: supply
            2: ground
        params:
            value: "100nF"
        metadata:
            custom:
                placement: "Place beside MCU pad 6, short return to ground."
    )
    inst decouple_pin_11: Capacitor0603(
        connections:
            1: supply
            2: ground
        params:
            value: "100nF"
        metadata:
            custom:
                placement: "Place beside MCU pad 11, short return to ground."
    )
    inst decouple_pin_21: Capacitor0603(
        connections:
            1: supply
            2: ground
        params:
            value: "100nF"
        metadata:
            custom:
                placement: "Place beside MCU pad 21, short return to ground."
    )
    inst decouple_pin_22: Capacitor0603(
        connections:
            1: supply
            2: ground
        params:
            value: "100nF"
        metadata:
            custom:
                placement: "Place beside MCU pad 22, short return to ground."
    )
    inst decouple_pin_28: Capacitor0603(
        connections:
            1: supply
            2: ground
        params:
            value: "100nF"
        metadata:
            custom:
                placement: "Place beside MCU pad 28, short return to ground."
    )
    inst decouple_pin_50: Capacitor0603(
        connections:
            1: supply
            2: ground
        params:
            value: "100nF"
        metadata:
            custom:
                placement: "Place beside MCU pad 50, short return to ground."
    )
    inst decouple_pin_73: Capacitor0603(
        connections:
            1: supply
            2: ground
        params:
            value: "100nF"
        metadata:
            custom:
                placement: "Place beside MCU pad 73, short return to ground."
    )
    inst decouple_pin_75: Capacitor0603(
        connections:
            1: supply
            2: ground
        params:
            value: "100nF"
        metadata:
            custom:
                placement: "Place beside MCU pad 75, short return to ground."
    )
    inst decouple_pin_100: Capacitor0603(
        connections:
            1: supply
            2: ground
        params:
            value: "100nF"
        metadata:
            custom:
                placement: "Place beside MCU pad 100, short return to ground."
    )
    inst supply_bulk: Capacitor0603(
        connections:
            1: supply
            2: ground
        params:
            value: "4.7uF"
    )
    inst analog_bulk: Capacitor0603(
        connections:
            1: supply
            2: ground
        params:
            value: "1uF"
        metadata:
            custom:
                placement: "Place beside MCU pad 22."
    )
    inst reference_bulk: Capacitor0603(
        connections:
            1: supply
            2: ground
        params:
            value: "1uF"
        metadata:
            custom:
                placement: "Place beside MCU pad 21."
    )
    inst usb_bulk: Capacitor0603(
        connections:
            1: supply
            2: ground
        params:
            value: "1uF"
        metadata:
            custom:
                placement: "Place beside MCU pad 73."
    )
    inst vcap_pin_48: Capacitor0603(
        connections:
            1: vcap
            2: ground
        params:
            value: "2.2uF"
        metadata:
            custom:
                placement: "Place beside MCU pad 48; low ESR, do not connect VCAP to 3.3 V."
    )
    inst vcap_pin_98: Capacitor0603(
        connections:
            1: vcap
            2: ground
        params:
            value: "2.2uF"
        metadata:
            custom:
                placement: "Place beside MCU pad 98; low ESR, do not connect VCAP to 3.3 V."
    )
    inst crystal: CrystalHC49(
        connections:
            1: osc_in
            2: osc_out
    )
    inst crystal_load_in: Capacitor0603(
        connections:
            1: osc_in
            2: ground
        params:
            value: "27pF"
        metadata:
            custom:
                placement: "C0G; provisional for CL18pF crystal, tune for PCB stray capacitance."
    )
    inst crystal_load_out: Capacitor0603(
        connections:
            1: osc_out
            2: ground
        params:
            value: "27pF"
        metadata:
            custom:
                placement: "C0G; provisional for CL18pF crystal, tune for PCB stray capacitance."
    )
    inst reset_cap: Capacitor0603(
        connections:
            1: debug.reset#
            2: ground
        params:
            value: "100nF"
    )
