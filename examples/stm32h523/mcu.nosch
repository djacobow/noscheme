// STM32H523 pin roles, decoupling, crystal, and public subsystem interface.

from noscheme import role, nettype, unused, bias
from MCU_ST_STM32H5 import STM32H523VCTx
from interfaces import I2C, SPI, USB2, SWD
from components import Capacitor0603, CrystalHC49

component STM32H523Board extends STM32H523VCTx:
  defaults:
    value: "STM32H523VCT6"
  pins:
    [1..5, 38..41, 46, 70..72]: [role.digital_bidirectional, unused.never]
    [6, 11, 21..22, 28, 50, 73, 75, 100]: [role.power_input, unused.never]
    [10, 19..20, 27, 49, 74, 99]: [role.ground, unused.never]
    12: [role.analog_input, unused.never]
    13: [role.analog_output, unused.never]
    14: [role.open_drain, unused.never]
    // I2C pins: firmware leaves the internal pull-ups off; board resistors set the level.
    [66..67, 92..93]: [role.open_drain, unused.never, bias.none]
    [15..17, 25, 29..30, 32, 42..43, 45, 55, 89]: [role.digital_output, unused.never]
    [18, 26, 31, 33..34, 44, 56, 76, 94]: [role.digital_input, unused.never]
    [48, 98]: [role.power_output, unused.never]

// Concrete reference-board implementations.
// Sources and pin allocation are recorded in docs/PROJECT.md.
// These blocks expose logical interfaces over explicit physical pins.
// Support parts are explicitly instantiated inside each block.
block MCU_H523:
  ports:
    supply: nettype.power
    ground: nettype.ground
    usb: USB2
    debug: SWD
    sd: SPI
    sd_detect#: nettype.digital
    oled: I2C
    expansion_i2c: I2C
    expansion_spi: SPI
    expansion_gpio: nettype.bidirectional[10]
    led_drive: nettype.digital[3]
    buttons#: nettype.digital[2]
    boot0: nettype.digital
    uart_tx: nettype.digital[2]
    uart_rx: nettype.digital[2]
  metadata:
    custom:
      intended_mcu: "STM32H523VCT6"
      intended_package: "LQFP-100"

  net osc_in: nettype.analog
  net osc_out: nettype.analog
  net vcap: nettype.power
    waivers:
      multiple_drivers: "VCAP pins 48 and 98 belong to the same internal regulator (AN5711)."
  // Signal aliases come from KiCad; grouped supplies keep physical pad numbers.
  inst chip: STM32H523Board
    PE2: expansion_gpio[0]
    PE3: expansion_gpio[1]
    PE4: expansion_gpio[2]
    PE5: expansion_gpio[3]
    PE6: expansion_gpio[4]
    [6, 11, 21..22, 28, 50, 73, 75, 100]: supply
    [7..9, 23..24, 35..37, 47, 51..54, 57..65, 68..69, 77..88, 90..91, 95..97]: no_connect
    [10, 19..20, 27, 49, 74, 99]: ground
    PH0: osc_in
    PH1: osc_out
    NRST: debug.reset#
    PC0: led_drive[0]
    PC1: led_drive[1]
    PC2: led_drive[2]
    PC3: sd_detect#
    PA2: uart_tx[0]
    PA3: uart_rx[0]
    PA4: sd.cs#
    PA5: sd.sck
    PA6: sd.miso
    PA7: sd.mosi
    PC4: buttons#[0]
    PC5: buttons#[1]
    PE7: expansion_gpio[5]
    PE8: expansion_gpio[6]
    PE9: expansion_gpio[7]
    PE10: expansion_gpio[8]
    PE11: expansion_spi.cs#
    PE12: expansion_spi.sck
    PE13: expansion_spi.miso
    PE14: expansion_spi.mosi
    PE15: expansion_gpio[9]
    [48, 98]: vcap
    PD8: uart_tx[1]
    PD9: uart_rx[1]
    PC9: expansion_i2c.sda
    PA8: expansion_i2c.scl
    PA11: usb.dm
    PA12: usb.dp
    72: debug.swdio
    76: debug.swclk
    89: debug.swo
    PB6: oled.scl
    PB7: oled.sda
    BOOT0: boot0
  inst decouple_pin_6: Capacitor0603
    1: supply
    2: ground
    params:
      value: 100n
    metadata:
      custom:
        placement: "Place beside MCU pad 6, short return to ground."
  inst decouple_pin_11: Capacitor0603
    1: supply
    2: ground
    params:
      value: 100n
    metadata:
      custom:
        placement: "Place beside MCU pad 11, short return to ground."
  inst decouple_pin_21: Capacitor0603
    1: supply
    2: ground
    params:
      value: 100n
    metadata:
      custom:
        placement: "Place beside MCU pad 21, short return to ground."
  inst decouple_pin_22: Capacitor0603
    1: supply
    2: ground
    params:
      value: 100n
    metadata:
      custom:
        placement: "Place beside MCU pad 22, short return to ground."
  inst decouple_pin_28: Capacitor0603
    1: supply
    2: ground
    params:
      value: 100n
    metadata:
      custom:
        placement: "Place beside MCU pad 28, short return to ground."
  inst decouple_pin_50: Capacitor0603
    1: supply
    2: ground
    params:
      value: 100n
    metadata:
      custom:
        placement: "Place beside MCU pad 50, short return to ground."
  inst decouple_pin_73: Capacitor0603
    1: supply
    2: ground
    params:
      value: 100n
    metadata:
      custom:
        placement: "Place beside MCU pad 73, short return to ground."
  inst decouple_pin_75: Capacitor0603
    1: supply
    2: ground
    params:
      value: 100n
    metadata:
      custom:
        placement: "Place beside MCU pad 75, short return to ground."
  inst decouple_pin_100: Capacitor0603
    1: supply
    2: ground
    params:
      value: 100n
    metadata:
      custom:
        placement: "Place beside MCU pad 100, short return to ground."
  inst supply_bulk: Capacitor0603(supply, ground, value=4.7u)
  inst analog_bulk: Capacitor0603
    1: supply
    2: ground
    params:
      value: 1u
    metadata:
      custom:
        placement: "Place beside MCU pad 22."
  inst reference_bulk: Capacitor0603
    1: supply
    2: ground
    params:
      value: 1u
    metadata:
      custom:
        placement: "Place beside MCU pad 21."
  inst usb_bulk: Capacitor0603
    1: supply
    2: ground
    params:
      value: 1u
    metadata:
      custom:
        placement: "Place beside MCU pad 73."
  inst vcap_pin_48: Capacitor0603
    1: vcap
    2: ground
    params:
      value: 2.2u
    metadata:
      custom:
        placement: "Place beside MCU pad 48; low ESR, do not connect VCAP to 3.3 V."
  inst vcap_pin_98: Capacitor0603
    1: vcap
    2: ground
    params:
      value: 2.2u
    metadata:
      custom:
        placement: "Place beside MCU pad 98; low ESR, do not connect VCAP to 3.3 V."
  inst crystal: CrystalHC49(osc_in, osc_out)
  inst crystal_load_in: Capacitor0603
    1: osc_in
    2: ground
    params:
      value: 27p
    metadata:
      custom:
        placement: "C0G; provisional for CL18pF crystal, tune for PCB stray capacitance."
  inst crystal_load_out: Capacitor0603
    1: osc_out
    2: ground
    params:
      value: 27p
    metadata:
      custom:
        placement: "C0G; provisional for CL18pF crystal, tune for PCB stray capacitance."
  inst reset_cap: Capacitor0603(debug.reset#, ground, value=100n)
