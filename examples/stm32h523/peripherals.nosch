// USB-C power/data, regulator, microSD, and SWD subsystems.

from noscheme import role, net
from interfaces import SPI, USB2, SWD
from components import Resistor0603, InputBias0603, InputPullup0603, Capacitor0603

component UsbCConnector:
  pins:
    [A1, A12, A4, A5, A6, A7, A8, A9, B1, B12, B4, B5, B6, B7, B8, B9, SH]: role.passive
  metadata:
    ref_prefix: "J"
    footprint: "Connector_USB:USB_C_Receptacle_HRO_TYPE-C-31-M-12"

component TLV1117LV33:
  pins:
    "1": role.ground
    "2": role.power_output
    "3": role.power_input
  metadata:
    value: "TLV1117LV33DCYR"
    ref_prefix: "U"
    footprint: "Package_TO_SOT_SMD:SOT-223-3_TabPin2"

component MicroSDConnector:
  pins:
    [1..10, SH]: role.passive
  metadata:
    ref_prefix: "J"
    footprint: "Connector_Card:microSD_HC_Hirose_DM3AT-SF-PEJM5"

component CortexHeader:
  pins:
    1..10: role.passive
  metadata:
    ref_prefix: "J"
    footprint: "Connector_PinHeader_1.27mm:PinHeader_2x05_P1.27mm_Vertical_SMD"

block UsbC:
  metadata:
    erc_choices:
      power_mode: ["source", "absent"]
  ports:
    net.power vbus
    net.ground ground
    USB2 data
  net.passive cc[2]
  UsbCConnector connector:
    [A1, A12, B1, B12, SH]: ground
    [A4, A9, B4, B9]: vbus
    A5: cc[0]
    [A6, B6]: data.dp
    [A7, B7]: data.dm
    [A8, B8]: no_connect
    B5: cc[1]
    metadata:
      pins:
        A4: choice(power_mode, source=role.power_output, absent=role.passive)
        [A6, A7]: role.digital_bidirectional
  Resistor0603<5.1k> cc_pulldowns[2](cc, ground)

block Ldo3v3:
  ports:
    net.power input
    net.power output
    net.ground ground
  TLV1117LV33 regulator(1: ground, 2: output, 3: input)
  Capacitor0603<1u> input_cap(input, ground)
  Capacitor0603<4.7u> output_cap(output, ground)
  // POC: direct rails, no reverse-feed isolation or automatic power selection.

block MicroSD:
  ports:
    net.power supply
    net.ground ground
    SPI bus
    net.digital detect#
  net.passive unused_dat[2]
  MicroSDConnector socket:
    1: unused_dat[0]
    2: bus.cs#
    3: bus.mosi
    4: supply
    5: bus.sck
    [6, 9, SH]: ground
    7: bus.miso
    8: unused_dat[1]
    10: detect#
    metadata:
      pins:
        [2..3, 5]: role.digital_input
        4: role.power_input
        6: role.ground
        7: role.digital_output
  // DAT1/DAT2 are unused by SPI but each has a physical pull-up to supply.
  // These passive nets have no resistance budget; their two-terminal wiring
  // is explicit even though no bias metadata is needed for current checks.
  InputBias0603 unused_dat_pullups[2](supply, unused_dat)
  InputPullup0603 cs_pullup(1: supply, 2: bus.cs#)
  InputPullup0603 miso_pullup(1: supply, 2: bus.miso)
  InputPullup0603 detect_pullup(1: supply, 2: detect#)
  Capacitor0603<100n> decouple:
    1: supply
    2: ground
    metadata:
      custom:
        placement: "Place adjacent to microSD VDD pad."
  Capacitor0603<4.7u> bulk(supply, ground)

block CortexDebug:
  ports:
    net.power reference
    net.ground ground
    SWD debug
  CortexHeader header:
    1: reference
    2: debug.swdio
    [3, 5, 9]: ground
    4: debug.swclk
    6: debug.swo
    7..8: no_connect
    10: debug.reset#
    metadata:
      pins:
        1: role.power_input
        2: role.digital_bidirectional
        3: role.ground
        4: role.digital_output
        6: role.digital_input
        10: role.open_drain
