// Shared signal bundles used by the board and reusable subsystems.

from noscheme import net, pull, std

// Every I2C line needs pull-ups in the standard-mode range: 1.5 to 10 kOhm in parallel.
extend net.idle_high I2CLine:
  checks:
    up: std.parallel(pull_resistance, where=pull.up, min=1.5k, max=10k)

bundle I2C:
  I2CLine scl
  I2CLine sda

bundle SPI:
  net.digital sck
  net.digital mosi
  net.digital miso
  net.digital cs#

bundle USB2:
  net.bidirectional dp
  net.bidirectional dm

bundle SWD:
  net.digital swclk
  net.bidirectional swdio
  net.digital swo
  net.idle_high reset#
