// Shared signal bundles used by the board and reusable subsystems.

from noscheme import nettype, bias, std

// Every I2C line needs pull-ups in the standard-mode range: 1.5 to 10 kOhm in parallel.
nettype I2CLine extends nettype.open_drain:
  checks:
    pull_up: std.parallel(pull_resistance, where=bias.pull_up, min=1.5k, max=10k)

bundle I2C:
  scl: I2CLine
  sda: I2CLine

bundle SPI:
  sck: nettype.digital
  mosi: nettype.digital
  miso: nettype.digital
  cs#: nettype.digital

bundle USB2:
  dp: nettype.bidirectional
  dm: nettype.bidirectional

bundle SWD:
  swclk: nettype.digital
  swdio: nettype.bidirectional
  swo: nettype.digital
  reset#: nettype.open_drain
