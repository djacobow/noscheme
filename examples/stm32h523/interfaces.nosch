// Shared signal bundles used by the board and reusable subsystems.

from noscheme import net, bias, std

// Every I2C line needs pull-ups in the standard-mode range: 1.5 to 10 kOhm in parallel.
extend net.open_drain I2CLine:
  checks:
    pull_up: std.parallel(pull_resistance, where=bias.pull_up, min=1.5k, max=10k)

bundle I2C:
  I2CLine scl
  I2CLine sda

bundle SPI:
  net.digital sck
  net.digital mosi
  net.digital miso
  net.digital cs#

bundle USB2:
  net.bidirectional dp
  net.bidirectional dm

bundle SWD:
  net.digital swclk
  net.bidirectional swdio
  net.digital swo
  net.open_drain reset#
