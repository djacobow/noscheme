// 10 MHz timebase: a VCTCXO (fitted) or OCXO (alternative footprint) steered
// by a 16-bit DAC, the 10 MHz SMA in/out stage, and the clock jumper.

from noscheme import role, net, use, pull, drive
from interfaces import SpiOut
from components import Resistor0603, Pulldown0603, Capacitor0603, Capacitor0805
from components import Vctcxo, EdgeSma, ThreeWayJumper
import Oscillator
import Analog_DAC
import Reference_Voltage
import Amplifier_Operational
import C_74xGxx

// 14-pin DIP-format OCXO: pin 1 EFC, 7 GND, 8 OUT, 14 VCC. Not assembled by
// JLC; fit by hand together with its supply-select resistor.
extend Oscillator.OCXO_14<"10MHz OCXO, DIP-14"> Ocxo:
  pins:
    "1": [role.analog_input, use.required]
    "7": [role.ground, use.required]
    "8": [role.digital_output, use.required]
    "14": [role.power_input, use.required]
  metadata:
    bom:
      dnp: true

// The DGK (VSSOP-8) package; the KiCad symbol's default footprint is the DRB.
extend Analog_DAC.DAC8551IxDGK<"DAC8551IDGKR"> TrimDac:
  pins:
    "1": role.power_input
    "2": role.power_input
    "3": role.analog_input
    "4": role.analog_output
    "8": role.ground
  metadata:
    footprint: "Package_SO:VSSOP-8_3x3mm_P0.65mm"
    bom:
      manufacturer: "TI"
      mpn: "DAC8551IDGKR"
      supplier: "LCSC"
      supplier_part_number: "C477934"

extend Reference_Voltage.REF3025<"REF3025AIDBZR"> Reference2v5:
  pins:
    "1": role.power_input
    "3": role.ground
  metadata:
    bom:
      manufacturer: "TI"
      mpn: "REF3025AIDBZR"
      supplier: "LCSC"
      supplier_part_number: "C11334"

extend Amplifier_Operational.MCP6001_OT<"MCP6001T-I/OT"> EfcAmplifier:
  pins:
    "1": role.analog_output
    "2": role.ground
    ["3", "4"]: role.analog_input
    "5": role.power_input
  metadata:
    bom:
      manufacturer: "Microchip"
      mpn: "MCP6001T-I/OT"
      supplier: "LCSC"
      supplier_part_number: "C116490"

extend C_74xGxx.C_74LVC1G17<"74LVC1G17GV"> Squarer:
  pins:
    "3": role.ground
    "5": role.power_input
  metadata:
    footprint: "Package_TO_SOT_SMD:SOT-23-5"
    bom:
      manufacturer: "Nexperia"
      mpn: "74LVC1G17GV,125"
      supplier: "LCSC"
      supplier_part_number: "C6076"

extend C_74xGxx.C_74LVC1G125<"SN74LVC1G125DBVR"> OutputBuffer:
  pins:
    "3": role.ground
    "5": role.power_input
  metadata:
    footprint: "Package_TO_SOT_SMD:SOT-23-5"
    bom:
      manufacturer: "TI"
      mpn: "SN74LVC1G125DBVR"
      supplier: "LCSC"
      supplier_part_number: "C23654"

// S low connects B1 to A; S high connects B2. The switch passes signals
// without driving them, so its channel pins are passive.
extend C_74xGxx.C_74LVC1G3157<"74LVC1G3157DW-7"> ClockMux:
  pins:
    ["1", "3", "4"]: role.passive
    "2": role.ground
    "5": role.power_input
  metadata:
    footprint: "Package_TO_SOT_SMD:SOT-363_SC-70-6"
    bom:
      manufacturer: "Diodes Incorporated"
      mpn: "74LVC1G3157DW-7"
      supplier: "LCSC"
      supplier_part_number: "C176651"

// AC-couples a sine, clipped-sine, or CMOS clock and squares it at mid-rail.
block ClockSquarer:
  ports:
    net.power supply
    net.ground ground
    net.passive input
    net.digital output
  net.passive biased
  Capacitor0603<100n> coupling(input, biased)
  Resistor0603<10k> bias_high(supply, biased)
  Resistor0603<10k> bias_low(biased, ground)
  Squarer buffer:
    "1": no_connect
    "2": biased
    "3": ground
    "4": output
    "5": supply
  Capacitor0603<100n> decouple(supply, ground)

// DAC -> 1.6 Hz RC filter -> x1.56 non-inverting buffer: 0 to 3.9 V EFC
// from the 2.5 V reference. The amplifier runs from 5 V for that headroom.
block TrimControl:
  ports:
    net.power quiet
    net.power amplifier_supply
    net.ground ground
    SpiOut spi
    net.digital sync#
    net.analog efc
  net.power reference
  net.analog dac_out
  net.analog filtered
  net.analog feedback

  Reference2v5 ref:
    "1": quiet
    "2": reference
    "3": ground
  Capacitor0603<1u> ref_input_cap(quiet, ground)
  Capacitor0603<1u> ref_output_cap(reference, ground)

  TrimDac dac:
    "1": quiet
    "2": reference
    ["3", "4"]: dac_out
    "5": sync#
    "6": spi.sck
    "7": spi.mosi
    "8": ground
  Capacitor0603<100n> dac_decouple(quiet, ground)
  Capacitor0603<1u> dac_bulk(quiet, ground)

  Resistor0603<10k> filter_resistor(dac_out, filtered)
  Capacitor0805<10u> filter_cap(filtered, ground)

  EfcAmplifier amplifier:
    "1": efc
    "2": ground
    "3": filtered
    "4": feedback
    "5": amplifier_supply
  Resistor0603<5.6k> gain_feedback(efc, feedback)
  Resistor0603<10k> gain_ground(feedback, ground)
  Capacitor0603<100n> amplifier_decouple(amplifier_supply, ground)

// Oscillators, the 10 MHz SMA, and the clock jumper. The direction jumper
// shunts pin 2 to ground (output, also the default with no shunt) or to
// 3.3 V (input).
block Timebase:
  ports:
    net.power quiet
    net.power logic
    net.power led_supply
    net.power input_supply
    net.ground ground
    SpiOut spi
    net.digital dac_sync#
    net.passive direction
    net.passive osc_in
    net.passive timer_clock
    net.analog efc
  net.passive vctcxo_out
  net.passive ocxo_out
  net.passive oscillator
  net.passive ocxo_supply
  net.passive vctcxo_control
  net.passive sma_center
  net.passive sma_drive
  net.digital local_clock
  net.digital external_clock
  net.passive reference

  TrimControl trim(
    quiet: quiet,
    amplifier_supply: led_supply,
    ground: ground,
    spi: spi,
    sync#: dac_sync#,
    efc: efc,
  )

  // Fitted: VCTCXO. Its 1 k series resistor limits current if the EFC swing
  // exceeds the 3.3 V supply; firmware clamps the DAC code for this part.
  Vctcxo vctcxo:
    vc: vctcxo_control
    gnd: ground
    out: vctcxo_out
    vdd: quiet
  Resistor0603<1k> vctcxo_control_series(efc, vctcxo_control)
  Capacitor0603<100n> vctcxo_decouple(quiet, ground)
  Capacitor0603<100n> vctcxo_couple(vctcxo_out, oscillator)

  // Alternative: OCXO, supplied from 12 V or 5 V by one of two 0 ohm links.
  Ocxo ocxo:
    "1": efc
    "7": ground
    "8": ocxo_out
    "14": ocxo_supply
  Resistor0603<0> ocxo_from_12v(input_supply, ocxo_supply):
    metadata:
      bom:
        dnp: true
  Resistor0603<0> ocxo_from_5v(led_supply, ocxo_supply):
    metadata:
      bom:
        dnp: true
  Capacitor0805<10u> ocxo_bulk(ocxo_supply, ground)
  Capacitor0603<100n> ocxo_couple(ocxo_out, oscillator):
    metadata:
      bom:
        dnp: true

  ClockSquarer local_squarer(supply: quiet, ground: ground, input: oscillator, output: local_clock)

  EdgeSma sma(1: sma_center, 2: ground)
  // Fit for a 50 ohm terminated input; leave out when driving the output.
  Resistor0603<49.9> sma_termination(sma_center, ground):
    metadata:
      bom:
        dnp: true
  ClockSquarer external_squarer(
    supply: logic,
    ground: ground,
    input: sma_center,
    output: external_clock,
  )

  OutputBuffer output_buffer:
    "1": direction
    "2": local_clock
    "3": ground
    "4": sma_drive
    "5": logic
  Resistor0603<33> output_series(sma_drive, sma_center)
  Capacitor0603<100n> output_decouple(logic, ground)

  ClockMux mux:
    "1": external_clock
    "2": ground
    "3": local_clock
    "4": reference
    "5": logic
    "6": direction
  Capacitor0603<100n> mux_decouple(logic, ground)

  ThreeWayJumper direction_jumper:
    A: ground
    C: direction
    B: logic
  Pulldown0603<10k> direction_default(1: direction, 2: ground)

  // Shunt 1-2: 10 MHz into OSC_IN (HSE bypass). Shunt 2-3: into TIM2_ETR.
  ThreeWayJumper clock_jumper:
    A: osc_in
    C: reference
    B: timer_clock
