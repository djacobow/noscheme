from noscheme import role, use, drive

component Conn_ARM_JTAG_SWD_10:
  params:
    string value = "Conn_ARM_JTAG_SWD_10"
  pins:
    "1" (VTref):
      role: [role.ground, role.power_input]
      custom:
        kicad_pin_types: ["power_in"]
    "10" ("~{RESET}"):
      drive: drive.low
      custom:
        kicad_pin_types: ["open_collector"]
    "2" ("SWDIO/TMS"):
      role: role.digital_bidirectional
      custom:
        kicad_pin_types: ["bidirectional"]
    "3":
      role: [role.ground, role.power_input]
      custom:
        kicad_pin_types: ["power_in"]
    "4" ("SWCLK/TCK"):
      role: role.digital_output
      custom:
        kicad_pin_types: ["output"]
    "5":
      role: role.passive
      custom:
        kicad_pin_types: ["passive"]
    "6" ("SWO/TDO"):
      role: role.digital_input
      custom:
        kicad_pin_types: ["input"]
    "7" (KEY):
      use: use.disallowed
      custom:
        kicad_pin_types: ["no_connect"]
    "8" ("NC/TDI"):
      role: role.digital_output
      custom:
        kicad_pin_types: ["output"]
    "9" (GNDDetect):
      role: role.passive
      custom:
        kicad_pin_types: ["passive"]
  metadata:
    ref_prefix: "J"
    custom:
      kicad_symbol: "Connector:Conn_ARM_JTAG_SWD_10"
      kicad_duplicate_pin_numbers_are_jumpers: "no"
      kicad_footprint_candidates: [
        "Connector_PinHeader_1.27mm:PinHeader_2x05_P1.27mm_Horizontal",
        "Connector_PinHeader_1.27mm:PinHeader_2x05_P1.27mm_Vertical",
        "Connector_PinHeader_1.27mm:PinHeader_2x05_P1.27mm_Vertical_SMD",
      ]
      kicad_properties:
        "Datasheet": "http://infocenter.arm.com/help/topic/com.arm.doc.ddi0314h/DDI0314H_coresight_components_trm.pdf"
        "Description": "Cortex Debug Connector, standard ARM Cortex-M SWD and JTAG interface"
        "Footprint": ""
        "Reference": "J"
        "Value": "Conn_ARM_JTAG_SWD_10"
        "ki_fp_filters": "PinHeader?2x05?P1.27mm*"
        "ki_keywords": "Cortex Debug Connector ARM SWD JTAG"

