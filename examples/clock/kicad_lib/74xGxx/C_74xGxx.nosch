from noscheme import role, use, drive

component C_74LVC1G125:
  params:
    string value = "74LVC1G125"
  pins:
    "1":
      role: role.digital_input
      custom:
        kicad_pin_types: ["input"]
    "2":
      role: role.digital_input
      custom:
        kicad_pin_types: ["input"]
    "3" (GND):
      role: [role.ground, role.power_input]
      custom:
        kicad_pin_types: ["power_in"]
    "4":
      role: role.digital_output
      tristate_capable: true
      custom:
        kicad_pin_types: ["tri_state"]
    "5" (VCC):
      role: [role.ground, role.power_input]
      custom:
        kicad_pin_types: ["power_in"]
  metadata:
    ref_prefix: "U"
    custom:
      kicad_symbol: "74xGxx:74LVC1G125"
      kicad_duplicate_pin_numbers_are_jumpers: "no"
      kicad_footprint_candidates: [
        "Package_SON:Texas_X2SON-5_0.8x0.8mm_P0.48mm",
        "Package_SON:Texas_X2SON-5_0.8x0.8mm_P0.48mm_RoutingVia",
        "Package_TO_SOT_SMD:SOT-23-5",
        "Package_TO_SOT_SMD:SOT-23-5_HandSoldering",
        "Package_TO_SOT_SMD:Texas_R-PDSO-G5_DCK-5",
        "Package_TO_SOT_SMD:Texas_R-PDSO-N5_DRL-5",
      ]
      kicad_properties:
        "Datasheet": "https://www.ti.com/lit/ds/symlink/sn74lvc1g125.pdf"
        "Description": "Single Buffer Gate Tri-State, Low-Voltage CMOS"
        "Footprint": ""
        "Reference": "U"
        "Value": "74LVC1G125"
        "ki_fp_filters": "SOT?23* Texas?R-PDSO-G5?DCK* Texas?R-PDSO-N5?DRL* Texas?X2SON*0.8x0.8mm*P0.48mm*"
        "ki_keywords": "Single Gate Buff Tri-State LVC CMOS"

