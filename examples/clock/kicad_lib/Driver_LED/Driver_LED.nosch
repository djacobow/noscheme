        kicad_pin_types: ["open_collector"]
    "8" ("~{OUT3}"):
      drive: drive.low
      custom:
        kicad_pin_types: ["open_collector"]
    "9" ("~{OUT4}"):
      drive: drive.low
      custom:
        kicad_pin_types: ["open_collector"]
