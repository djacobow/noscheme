        footprint: "Connector_Card:microSD_HC_Hirose_DM3AT-SF-PEJM5"

component CortexHeader:
    pins:
        "1":
            role: role.passive
            unused: unused.explicit
        "2":
            role: role.passive
            unused: unused.explicit
        "3":
            role: role.passive
            unused: unused.explicit
        "4":
            role: role.passive
            unused: unused.explicit
        "5":
            role: role.passive
            unused: unused.explicit
        "6":
            role: role.passive
            unused: unused.explicit
        "7":
            role: role.passive
            unused: unused.explicit
        "8":
            role: role.passive
            unused: unused.explicit
        "9":
            role: role.passive
            unused: unused.explicit
        "10":
            role: role.passive
            unused: unused.explicit
    metadata:
        ref_prefix: "J"
        footprint: "Connector_PinHeader_1.27mm:PinHeader_2x05_P1.27mm_Vertical_SMD"

block UsbC:
    metadata:
        erc_choices:
            power_mode: ["source", "absent"]
    ports:
        vbus: nettype.power
        ground: nettype.ground
        data: USB2
    net cc: nettype.passive[2]
    inst connector: UsbCConnector(
        connections:
            A1: ground
            A12: ground
            A4: vbus
            A5: cc[0]
            A6: data.dp
            A7: data.dm
            A8: no_connect
            A9: vbus
            B1: ground
            B12: ground
            B4: vbus
            B5: cc[1]
            B6: data.dp
            B7: data.dm
            B8: no_connect
            B9: vbus
            SH: ground
        metadata:
            pins:
                A4:
                    external_role:
                        choice: "power_mode"
                        cases:
                            source: role.power_output
                            absent: role.passive
                A6:
                    external_role: role.digital_bidirectional
                A7:
                    external_role: role.digital_bidirectional
    )
    inst cc_pulldowns[2]: Resistor0603(
        connections:
            1: cc
            2: ground
        params:
            value: "5.1kOhm"
    )

block Ldo3v3:
    ports:
        input: nettype.power
        output: nettype.power
        ground: nettype.ground
    inst regulator: TLV1117LV33(
        connections:
            1: ground
            2: output
            3: input
    )
    inst input_cap: Capacitor0603(
        connections:
            1: input
            2: ground
        params:
            value: "1uF"
    )
    inst output_cap: Capacitor0603(
        connections:
            1: output
            2: ground
        params:
            value: "4.7uF"
    )
    // POC: direct rails, no reverse-feed isolation or automatic power selection.

block MicroSD:
    ports:
        supply: nettype.power
        ground: nettype.ground
        bus: SPI
        detect#: nettype.digital
    net unused_dat: nettype.passive[2]
    inst socket: MicroSDConnector(
        connections:
            1: unused_dat[0]
            2: bus.cs#
            3: bus.mosi
            4: supply
            5: bus.sck
            6: ground
            7: bus.miso
            8: unused_dat[1]
            9: ground
            10: detect#
            SH: ground
        metadata:
            pins:
                2..3:
                    external_role: role.digital_input
                4:
                    external_role: role.power_input
                5:
                    external_role: role.digital_input
                6:
                    external_role: role.ground
                7:
                    external_role: role.digital_output
    )
    inst unused_dat_pullups[2]: InputBias0603(
        connections:
            1: supply
            2: unused_dat
    )
    inst cs_pullup: InputBias0603(
        connections:
            1: supply
            2: bus.cs#
        metadata:
            pins:
                2:
                    bias: bias.pull_up
                    pull_resistance_ohm: 10000
    )
    inst miso_pullup: InputBias0603(
        connections:
            1: supply
            2: bus.miso
        metadata:
            pins:
                2:
                    bias: bias.pull_up
                    pull_resistance_ohm: 10000
    )
    inst detect_pullup: InputBias0603(
        connections:
            1: supply
            2: detect#
        metadata:
            pins:
                2:
                    bias: bias.pull_up
                    pull_resistance_ohm: 10000
    )
    inst decouple: Capacitor0603(
        connections:
            1: supply
            2: ground
        params:
            value: "100nF"
        metadata:
            custom:
                placement: "Place adjacent to microSD VDD pad."
    )
    inst bulk: Capacitor0603(
        connections:
            1: supply
            2: ground
        params:
            value: "4.7uF"
    )

block CortexDebug:
    ports:
        reference: nettype.power
        ground: nettype.ground
        debug: SWD
    inst header: CortexHeader(
        connections:
            1: reference
            2: debug.swdio
            3: ground
            4: debug.swclk
            5: ground
            6: debug.swo
            7: no_connect
            8: no_connect
            9: ground
            10: debug.reset#
        metadata:
            pins:
                1:
                    external_role: role.power_input
                2:
                    external_role: role.digital_bidirectional
                3:
                    external_role: role.ground
                4:
                    external_role: role.digital_output
                6:
                    external_role: role.digital_input
                10:
                    external_role: role.open_drain
    )

board STM32H523Reference:
    metadata:
        erc_choices:
            power_source: ["usb", "header5v"]
        configurations:
            usb_powered:
                power_source: "usb"
            header_5v_powered:
                power_source: "header5v"
    global net gnd: nettype.ground
    global net v5: nettype.power
    global net v3v3: nettype.power

    net usb: USB2
    net debug: SWD
    net sd: SPI
    net sd_detect#: nettype.digital
    net oled: I2C
    net expansion_i2c: I2C
    net expansion_spi: SPI
    net expansion_gpio: nettype.bidirectional[10]
    net led_drive: nettype.digital[3]
    net buttons#: nettype.digital[2]
    net boot0: nettype.digital
    net uart_tx: nettype.digital[2]
    net uart_rx: nettype.digital[2]

    inst mcu: MCU_H523(
        connections:
            supply: global.v3v3
            ground: global.gnd
            usb: usb
            debug: debug
            sd: sd
            sd_detect#: sd_detect#
            oled: oled
            expansion_i2c: expansion_i2c
            expansion_spi: expansion_spi
            expansion_gpio: expansion_gpio
            led_drive: led_drive
            buttons#: buttons#
            boot0: boot0
            uart_tx: uart_tx
            uart_rx: uart_rx
    )

    inst usb_c: UsbC(
        connections:
            vbus: global.v5
            ground: global.gnd
            data: usb
        metadata:
            erc_choices:
                power_mode:
                    choice: "power_source"
                    cases:
                        usb: "source"
                        header5v: "absent"
    )

    inst regulator: Ldo3v3(
        connections:
            input: global.v5
            output: global.v3v3
            ground: global.gnd
    )

    inst micro_sd: MicroSD(
        connections:
            supply: global.v3v3
            ground: global.gnd
            bus: sd
            detect#: sd_detect#
    )

    inst swd: CortexDebug(
        connections:
            reference: global.v3v3
            ground: global.gnd
            debug: debug
    )

    // OLED header order: 3.3 V, ground, SCL, SDA; match the module cable to it.
    inst oled_decouple: Capacitor0603(
        connections:
            1: global.v3v3
            2: global.gnd
        params:
            value: "100nF"
        metadata:
            custom:
                placement: "Place beside display header supply pin."
    )
    inst oled_bulk: Capacitor0603(
        connections:
            1: global.v3v3
            2: global.gnd
        params:
            value: "4.7uF"
    )

    inst oled_header: Header1x4(
        connections:
            1: global.v3v3
            2: global.gnd
            3: oled.scl
            4: oled.sda
        metadata:
            pins:
                1:
                    external_role: role.power_input
                2:
                    external_role: role.ground
                3:
                    external_role: role.open_drain
                4:
                    external_role: role.open_drain
    )

    inst oled_scl_pullup: I2CPullup(
        connections:
            1: global.v3v3
            2: oled.scl
    )
    inst oled_sda_pullup: I2CPullup(
        connections:
            1: global.v3v3
            2: oled.sda
    )
    // Bias is explicitly modeled; check whether the chosen OLED module already
    // has pullups. Choose net resistance/capacitance limits after hardware review.

    // Illustrative header order: 4 power/ground + 2 I2C + 4 SPI + 10 other GPIO.
    // Bus pins are also GPIO-capable MCU pins, giving 16 GPIO connections total.
    inst expansion: Header2x10(
        connections:
            1: global.gnd
            2: global.gnd
            3: global.v5
            4: global.v3v3
            5: expansion_i2c.scl
            6: expansion_i2c.sda
            7: expansion_spi.sck
            8: expansion_spi.mosi
            9: expansion_spi.miso
            10: expansion_spi.cs#
            11..20: expansion_gpio[0:10]
        metadata:
            pins:
                1:
                    external_role: role.ground
                2:
                    external_role: role.ground
                3:
                    external_role:
                        choice: "power_source"
                        cases:
                            usb: role.power_input
                            header5v: role.power_output
                4:
                    external_role: role.power_input
                5:
                    external_role: role.open_drain
                6:
                    external_role: role.open_drain
                7:
                    external_role: role.digital_input
                8:
                    external_role: role.digital_input
                9:
                    external_role: role.digital_output
                10:
                    external_role: role.digital_input
                11..20:
                    external_role: role.digital_bidirectional
    )
    // Connector roles above describe the external equipment's endpoints.
    // Example SPI roles assume the board is controller; other uses need ERC configurations.
    inst expansion_scl_pullup: I2CPullup(
        connections:
            1: global.v3v3
            2: expansion_i2c.scl
    )
    inst expansion_sda_pullup: I2CPullup(
        connections:
            1: global.v3v3
            2: expansion_i2c.sda
    )

    // TX/RX are named from the MCU's perspective. Each header gets its own UART.
    inst uart_headers[2]: UartHeaderJST3(
        connections:
            gnd: global.gnd
            tx: uart_tx
            rx: uart_rx
        metadata:
            pins:
                1:
                    external_role: role.ground
                2:
                    external_role: role.digital_input
                3:
                    external_role: role.digital_output
    )

    // Two active-low buttons with independent pull-ups and common ground.
    inst buttons[2]: PushButton(
        connections:
            signal: buttons#
            ground: global.gnd
    )
    inst button_pullups[2]: InputBias0603(
        connections:
            1: global.v3v3
            2: buttons#
        metadata:
            pins:
                2:
                    bias: bias.pull_up
                    pull_resistance_ohm: 10000
    )
    // NRST uses the MCU internal pull-up and the existing 100 nF reset capacitor.
    inst reset_button: PushButton(
        connections:
            signal: debug.reset#
            ground: global.gnd
    )

    // Shunt installed: BOOT0 high. Shunt absent: resistor pulls BOOT0 low.
    inst boot_header: Header1x2(
        connections:
            1: global.v3v3
            2: boot0
    )
    inst boot_pulldown: InputBias0603(
        connections:
            1: boot0
            2: global.gnd
        metadata:
            pins:
                1:
                    bias: bias.pull_down
                    pull_resistance_ohm: 10000
    )
    // Bias annotations are explicit; passive parts alone do not imply propagation.

    inst indicators[3]: Indicator(
        connections:
            [0].drive: led_drive[0]
            [1].drive: led_drive[1]
            [2].drive: led_drive[2]
    )
    // Equivalent whole-array binding: drive: led_drive.
    // Use one form or the other; overlapping bindings are errors.

    // USB and header-5V configurations check the same direct physical rails.
    // External 3.3 V operation remains an operator-controlled experiment;
    // there is no LDO isolation and no model for a deliberately unpowered v5 rail.
