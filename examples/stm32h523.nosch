/*
STM32H523VCT6 proof-of-concept board, LQFP100.

All parts now have physical pin maps and footprints. This is a placement/routing
example, not a production-qualified design. See docs/PROJECT.md for source references
and pin allocation. USB and external power are operator-controlled: no reverse
feed protection or automatic source selection is provided.

Hardware follow-up: tune the 8 MHz HC49 crystal's provisional 27 pF load caps;
verify capacitor effective capacitance and regulator thermal headroom after
layout; configure MCU alternate functions, USB clocking, and boot option bytes.
Use the placement notes on decoupling capacitors during PCB layout. All small
resistors/capacitors use 0603. No unverified current capacities are annotated.
*/

// Explicit builtins and the converted KiCad MCU symbol.
from noscheme import role, nettype, unused, f, bias
from stm32h523_parts import STM32H523VCTx

bundle I2C:
    scl: nettype.open_drain
    sda: nettype.open_drain

bundle SPI:
    sck: nettype.digital
    mosi: nettype.digital
    miso: nettype.digital
    cs#: nettype.digital

bundle USB2:
    dp: nettype.bidirectional
    dm: nettype.bidirectional

bundle SWD:
    swclk: nettype.digital
    swdio: nettype.bidirectional
    swo: nettype.digital
    reset#: nettype.open_drain

// Explicit physical definitions for the remaining standard parts.
component Resistor:
    params:
        value: string
    pins:
        1:
            role: role.passive
            unused: unused.never
        2:
            role: role.passive
            unused: unused.never
    metadata:
        ref_prefix: "R"

component Resistor0603 extends Resistor:
    metadata:
        footprint: "Resistor_SMD:R_0603_1608Metric"

// Values are starting points for discussion, not selected from a power budget.
component LedResistor extends Resistor0603:
    defaults:
        value: f.kOhm(1)

component I2CPullup extends Resistor0603:
    pins:
        2:
            bias: bias.pull_up
            pull_resistance_ohm: 4700
    defaults:
        value: f.kOhm(4.7)

// Provisional values; verify input leakage and timing when selecting the MCU pins.
component InputBias0603 extends Resistor0603:
    defaults:
        value: f.kOhm(10)

component PushButton:
    pins:
        1:
            aliases: [signal]
            role: role.passive
            unused: unused.never
        2:
            aliases: [ground]
            role: role.passive
            unused: unused.never
    metadata:
        ref_prefix: "SW"
        value: "TS18-5-15-SL-260-SMT-TR"
        // TL3342 matches TS18 lands; each row is one internally common contact.
        footprint: "Button_Switch_SMD:SW_SPST_TL3342"

component Header1x2:
    pins:
        1..2:
            role: role.passive
            unused: unused.never
    metadata:
        ref_prefix: "J"
        footprint: "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical_SMD_Pin1Left"

component Led:
    params:
        value: string
    pins:
        1:
            aliases: [cathode, K]
            role: role.passive
            unused: unused.never
        2:
            aliases: [anode, A]
            role: role.passive
            unused: unused.never
    metadata:
        ref_prefix: "D"

component GreenLed0603 extends Led:
    defaults:
        value: "Green"
    metadata:
        footprint: "LED_SMD:LED_0603_1608Metric"
        // Draft convention: 1 cathode, 2 anode; verify against selected part.

block Indicator:
    params:
        resistance: string = f.kOhm(1)
    ports:
        drive: nettype.digital
    net anode: nettype.passive

    inst resistor: LedResistor(
        connections:
            1: drive
            2: anode
        params:
            value: resistance
    )
    inst led: GreenLed0603(
        connections:
            cathode: global.gnd
            anode: anode
    )
    // Global ground must be declared by the containing board.
    // No signal propagation or current calculation through the resistor.

component Header1x4:
    pins:
        1..4:
            unused: unused.explicit
    metadata:
        ref_prefix: "J"
        footprint: "Connector_PinHeader_2.54mm:PinHeader_1x04_P2.54mm_Vertical_SMD_Pin1Left"

component Header2x10:
    pins:
        1..20:
            unused: unused.explicit
    metadata:
        ref_prefix: "J"
        footprint: "Connector_PinHeader_2.54mm:PinHeader_2x10_P2.54mm_Vertical_SMD"

component UartHeaderJST3:
    pins:
        MP:
            role: role.do_not_connect
            unused: unused.always
        1:
            aliases: [gnd]
            unused: unused.explicit
        2:
            aliases: [tx]
            unused: unused.explicit
        3:
            aliases: [rx]
            unused: unused.explicit
    metadata:
        ref_prefix: "J"
        custom:
            connector_family: "JST"
        footprint: "Connector_JST:JST_XH_S3B-XH-SM4-TB_1x03-1MP_P2.50mm_Horizontal"

component Capacitor0603:
    params:
        value: string = "100nF"
    pins:
        1..2:
            role: role.passive
            unused: unused.never
    metadata:
        ref_prefix: "C"
        footprint: "Capacitor_SMD:C_0603_1608Metric"

component CrystalHC49:
    params:
        value: string = "8MHz CL18pF"
    pins:
        1..2:
            role: role.passive
            unused: unused.never
    metadata:
        ref_prefix: "Y"
        footprint: "Crystal:Crystal_SMD_HC49-SD"

