// WREN push-pull output subsystem. See README.md for attribution and scope.
from noscheme import net
from components import Bypass, Bulk, Protection, Driver, Resistor, Translator

block OutputPair:
  ports:
    net.unchecked supply
    net.unchecked ground
    net.unchecked enable#
    net.unchecked input[2]
    net.unchecked output[2]
  net.unchecked driven[4]
  Bypass bypass:
    1: supply
    2: ground
  // Upstream's bulk capacitor has the opposite pin orientation.
  Bulk bulk:
    1: ground
    2: supply
  Driver driver:
    [1, 4, 10, 13]: enable#
    [2, 5]: input[0]
    [9, 12]: input[1]
    3: driven[0]
    6: driven[1]
    8: driven[2]
    11: driven[3]
    7: ground
    14: supply
  Resistor<"R0402_4R7_1%_0.0625W_200PPM"> series[4]:
    1: driven
    [0:2].2: output[0]
    [2:4].2: output[1]
  Resistor<"R0402_1K_1%_0.0625W_100PPM"> pulldown[2]:
    1: ground
    2: output
  Protection protection[2]:
    1: output
    2: ground

block OutputBank:
  ports:
    net.unchecked supply
    net.unchecked logic_supply
    net.unchecked ground
    net.unchecked enable#
    net.unchecked input[4][2]
    net.unchecked output[4][2]
  net.unchecked translated[4][2]
  Translator translator:
    [1, 2]: logic_supply
    [23, 24]: supply
    [11, 12, 13, 22]: ground
    // Preserve the source's A2/A1 physical-pin ordering.
    [4, 3, 5..10]: flat(input)
    21..14: flat(translated)
  Bypass bypass3v3:
    1: supply
    2: ground
  Bypass bypass1v8:
    1: logic_supply
    2: ground
  OutputPair pairs[4](*, input: translated)
