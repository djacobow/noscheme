// WREN push-pull output subsystem. See README.md for attribution and scope.
from noscheme import nettype
from components import Bypass, Bulk, Protection, Driver, Resistor, Translator

block OutputPair:
  ports:
    supply: nettype.unchecked
    ground: nettype.unchecked
    enable#: nettype.unchecked
    input: nettype.unchecked[2]
    output: nettype.unchecked[2]
  net driven: nettype.unchecked[4]
  inst bypass: Bypass
    connections:
      1: supply
      2: ground
  // Upstream's bulk capacitor has the opposite pin orientation.
  inst bulk: Bulk
    connections:
      1: ground
      2: supply
  inst driver: Driver
    connections:
      [1, 4, 10, 13]: enable#
      [2, 5]: input[0]
      [9, 12]: input[1]
      3: driven[0]
      6: driven[1]
      8: driven[2]
      11: driven[3]
      7: ground
      14: supply
  inst series[4]: Resistor
    connections:
      1: driven
      [0:2].2: output[0]
      [2:4].2: output[1]
    params:
      value: "R0402_4R7_1%_0.0625W_200PPM"
  inst pulldown[2]: Resistor
    connections:
      1: ground
      2: output
    params:
      value: "R0402_1K_1%_0.0625W_100PPM"
  inst protection[2]: Protection
    connections:
      1: output
      2: ground

block OutputBank:
  ports:
    supply: nettype.unchecked
    logic_supply: nettype.unchecked
    ground: nettype.unchecked
    enable#: nettype.unchecked
    input: nettype.unchecked[4][2]
    output: nettype.unchecked[4][2]
  net translated: nettype.unchecked[4][2]
  inst translator: Translator
    connections:
      [1, 2]: logic_supply
      [23, 24]: supply
      [11, 12, 13, 22]: ground
      // Preserve the source's A2/A1 physical-pin ordering.
      4: input[0][0]
      3: input[0][1]
      5: input[1][0]
      6: input[1][1]
      7: input[2][0]
      8: input[2][1]
      9: input[3][0]
      10: input[3][1]
      21: translated[0][0]
      20: translated[0][1]
      19: translated[1][0]
      18: translated[1][1]
      17: translated[2][0]
      16: translated[2][1]
      15: translated[3][0]
      14: translated[3][1]
  inst bypass3v3: Bypass
    connections:
      1: supply
      2: ground
  inst bypass1v8: Bypass
    connections:
      1: logic_supply
      2: ground
  inst pairs[4]: OutputPair
    connections:
      supply: supply
      ground: ground
      enable#: enable#
      input: translated
      output: output
