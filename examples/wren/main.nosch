// A disconnected subsystem benchmark, not a standalone functional board.
from noscheme import net, role
from components import Resistor
from drivers import OutputBank

// Explicit boundary endpoints stand in for the remainder of WREN.
block SurroundingWren:
  ports:
    net.unchecked supply
    net.unchecked logic_supply
    net.unchecked ground
    net.unchecked enable#
    net.unchecked input[4][4][2]
    net.unchecked output[4][4][2]

board WrenOutputs:
  // Boundary nets represent power and signals provided by the rest of WREN.
  // Electrical policies are deliberately unchecked in this connectivity pilot.
  net.unchecked supply, logic_supply, ground, enable#
  net.unchecked input[4][4][2], output[4][4][2]
  OutputBank banks[4](*)
  Resistor<"R0402_10K_1%_0.0625W_100PPM"> enable_pullup:
    1: enable#
    2: supply
  SurroundingWren surrounding(*):
    metadata:
      pins:
        supply:
          external_role: role.unchecked
        logic_supply:
          external_role: role.unchecked
        ground:
          external_role: role.unchecked
        enable#:
          external_role: role.unchecked
        input:
          external_role: role.unchecked
        output:
          external_role: role.unchecked
