// Two build targets share one parameterized circuit.
from noscheme import net, role
from parts import Header
from indicator import Indicator

block Indicators:
  params:
    number count = 1
  global net.ground gnd
  global net.power v5
  Header input:
    1: global.v5
    2: global.gnd
    metadata:
      pins:
        1: role.power_output
        2: role.ground
  Indicator indicators[count](supply: global.v5)

extend Indicators<2> Double
