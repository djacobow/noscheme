// Three connectors demonstrate alternative external power sources.
// Each configuration checks the same physical board and pin connections.
from noscheme import role, net, unused

component Header:
  pins:
    1..2: [role.passive, unused.never]
  metadata:
    ref_prefix: "J"
    footprint: "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical"

block Supply:
  ports:
    net.power supply:
      unused: unused.never
  metadata:
    erc_choices:
      power_mode: ["source", "load", "absent"]
  Header connector:
    1: supply
    2: global.gnd
    metadata:
      pins:
        1: choice(power_mode, source=role.power_output, load=role.power_input, absent=role.passive)
        2: role.ground

board PowerModes:
  metadata:
    erc_choices:
      power_source: ["usb", "header"]
    configurations:
      usb_powered:
        power_source: "usb"
      header_powered:
        power_source: "header"
  global net.ground gnd
  net.power v5
  Supply usb:
    supply: v5
    metadata:
      erc_choices:
        power_mode: choice(power_source, usb="source", header="absent")
  Supply expansion:
    supply: v5
    metadata:
      erc_choices:
        power_mode: choice(power_source, usb="load", header="source")
  Header load:
    1: v5
    2: global.gnd
    metadata:
      pins:
        1: role.power_input
        2: role.ground
