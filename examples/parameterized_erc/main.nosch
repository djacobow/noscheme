// Electrical-model demonstration, not a fabrication design.
from noscheme import role, use, net, pull, std, drive

component Pullup:
  params:
    resistance value = 4.7k
  pins:
    1 (supply):
      role: role.passive
      use: use.required
    2 (signal):
      role: role.passive
      use: use.required
      pull: pull.up
      checks:
        reference: std.pull_reference("supply")
      pull_resistance: value
  metadata:
    ref_prefix: "R"
    footprint: "Resistor_SMD:R_0603_1608Metric"

component Endpoint:
  pins:
    1:
      drive: drive.low
      pull: pull.none
      min_voltage: -0.3
      max_voltage: 3.6
      use: use.required
    2: [role.power_output, use.required]
  metadata:
    custom:
      description: "Abstract external source and open-drain endpoint"

block Demo:
  net.power supply:
    min_voltage: 3.3 * 0.95
    max_voltage: 3.3 * 1.05
  net.idle_high bus:
    min_voltage: 0
    max_voltage: 3.3 * 1.05
    checks:
      up: std.parallel(pull_resistance, where=pull.up, min=1k)
  Pullup pulls[2](supply: supply, signal: bus):
    elements:
      [0]:
        params:
          value: 2.2k
        metadata:
          custom:
            placement: "At the bus controller"
      [1]:
        metadata:
          custom:
            placement: "At the remote connector"
  Endpoint endpoint(1: bus, 2: supply)
