// Adapted from Jeremy Elson / rulos, 6-Line Matrix Rev B. See README.md.
// Preserve source connectivity, including unused nets and unspecified values.
from noscheme import nettype, role
import matrix
from interfaces import Rows, LocalI2C, BufferedI2C
from display import TwoColumns
from components import Buck, Cap0603, Cap0805, BuckOutputCap, CortexHeader, Header2, Header3, I2CBuffer, I2CPullup, BuckOutputInductor, MCU, PChannel, PowerJack, RJ45, LogicRegulator, BusRegulator, BusOutputCap, Resistor

board SixLineMatrix:
  // ERC checks every combination of the two supply choices.
  metadata:
    erc_choices:
      supply_5v: ["jack", "header"]
      supply_12v: ["port0", "port1", "port2"]
  net blank#, clock, latch, rx, swclk, tx: nettype.digital
  // Switching/feedback nodes retain passive compatibility for this first pass.
  net bootstrap, feedback, switch_node: nettype.passive
  net gnd: nettype.ground
    voltage: 0..0
  net reset#: nettype.open_drain
  net swdio: nettype.bidirectional
  net scl, sda: LocalI2C
    wiring_capacitance: 50p
    voltage: 0..3.465
  net scl_hv, sda_hv: BufferedI2C
    wiring_capacitance: 100p
  // Supply voltages are assumed steady-state envelopes, not a regulator simulation.
  // BuckOutputInductor explicitly models the converter output at pad 2.
  net led_power: nettype.power
    checks:
      // 64 shared sinks, not 6 independent full-row loads.
      // 20mA matches the 1k R_EXT selection; 10% is a design allowance.
      // Extra 1mA covers feedback-divider current and steady leakage.
      display_load: matrix.shared_sink_budget(load=64 * 20m * 1.10 + 1m)
    voltage: 2.5 ± 5%
  net v10: nettype.power
    voltage: 10 ± 5%
  net v12: nettype.power
    voltage: 12 ± 5%
  net v5: nettype.power
    voltage: 5 ± 5%
  net vcc: nettype.power
    voltage: 3.3 ± 5%
  net rows: Rows
  net row_enable: nettype.digital[6]
  net serial_data: nettype.digital[5]

  // Four modules share controls and row buses. Slices form the serial chain.
  inst banks[4]: TwoColumns(
    rows: rows,
    supply: vcc,
    ground: gnd,
    clock: clock,
    latch: latch,
    blank: blank#,
    sdi: serial_data[0:4],
    sdo: serial_data[1:5],
  )

  inst mcu: MCU
    ["1", "17", "5"]: vcc
    "10": row_enable[4]
    "11": row_enable[5]
    "12": blank#
    "13": latch
    ["14", "15", "18", "2", "21", "22", "25", "27", "3"]: no_connect
    ["16", "31", "32"]: gnd
    "19": tx
    "20": rx
    "23": swdio
    "24": swclk
    "26": clock
    "28": serial_data[0]
    "29": scl
    "30": sda
    "4": reset#
    "6": row_enable[0]
    "7": row_enable[1]
    "8": row_enable[2]
    "9": row_enable[3]
    params:
      value: "STM32F303K8T6"

  inst power_header: Header2
    1: v5
    2: gnd
    params:
      value: "22-23-2021"
    metadata:
      pins:
        1: choice(supply_5v, jack=role.power_input, header=role.power_output)
        2: role.ground

  inst logic_regulator: LogicRegulator(1: gnd, 2: vcc, 3: v5)

  inst bus_regulator: BusRegulator(1: v12, 2: gnd, 3: v10)

  inst debug: CortexHeader
    "1": vcc
    "10": reset#
    "2": swdio
    ["3", "5", "9"]: gnd
    "4": swclk
    // PB3 is used for the LED clock, so trace output is unavailable.
    ["6", "7", "8"]: no_connect
    params:
      value: "CORTEX_HEADERJ"
    metadata:
      // Roles describe the attached debug probe, not the MCU.
      pins:
        1: role.power_input
        [3, 5, 9]: role.ground
        2: role.digital_bidirectional
        4: role.digital_output
        6: role.digital_input
        10: role.open_drain

  inst bus_buffer: I2CBuffer
    "1": sda
    ["2", "3"]: sda_hv
    "4": gnd
    ["5", "6"]: scl_hv
    "7": scl
    "8": v10
    params:
      value: "PCA9600SO8"

  inst uart: Header3
    1: tx
    2: rx
    3: gnd
    params:
      value: "22-23-2031"
    metadata:
      // External UART adapter receives TX and drives RX.
      pins:
        1: role.digital_input
        2: role.digital_output
        3: role.ground

  inst inductor: BuckOutputInductor(1: switch_node, 2: led_power, value=2.2u)

  inst feedback_top: Resistor(feedback, led_power, value=22.6k)

  inst feedback_bottom: Resistor(gnd, feedback, value=10k)

  inst buck: Buck
    "1": gnd
    "2": switch_node
    ["3", "5"]: v5
    "4": feedback
    "6": bootstrap
    params:
      value: "TPS563200"

  inst power_jack: PowerJack
    PWR: v5
    GND: gnd
    GNDBREAK: no_connect
    params:
      value: "PJ-036AH-SMT-TR"
    metadata:
      pins:
        PWR: choice(supply_5v, jack=role.power_output, header=role.power_input)
        GND: role.ground

  inst cap_1: Cap0805(v5, gnd, value=10u)

  inst cap_2: Cap0805(vcc, gnd, value=4.7u)

  inst cap_3: Cap0603(v12, gnd, value=1u)

  inst cap_4: BusOutputCap(1: v10, 2: gnd)

  inst cap_5: Cap0603(vcc, gnd, value=1u)

  inst cap_8: BuckOutputCap(1: led_power, 2: gnd)

  inst cap_9: BuckOutputCap(1: led_power, 2: gnd)

  inst cap_10: Cap0603(switch_node, bootstrap, value=100n)

  inst row_switch[6]: PChannel
    G: row_enable
    "2": led_power
    [0]."3": rows.row0
    [1]."3": rows.row1
    [2]."3": rows.row2
    [3]."3": rows.row3
    [4]."3": rows.row4
    [5]."3": rows.row5
    params:
      value: "MOSFET-PCHANNEL"

  inst bus_ports[3]: RJ45
    1: sda_hv
    [2, 5, 6, 8]: gnd
    3: scl_hv
    [4, 7]: v12
    params:
      value: "54602-908LF"
    metadata:
      pins:
        [1, 3]:
          role: role.open_drain
          // Per port, per signal: connector + cable + downstream devices.
          // All three branches count simultaneously; see README.
          capacitance: 1n
        [2, 5, 6, 8]: role.ground
    // Pins 4 and 7 carry the same external supply. Count it once, at pin 4;
    // the selected source's pin 7 is a passive parallel contact.
    elements:
      [0]:
        metadata:
          pins:
            4: choice(
              supply_12v,
              port0=role.power_output,
              port1=role.power_input,
              port2=role.power_input,
            )
            7: choice(
              supply_12v,
              port0=role.passive,
              port1=role.power_input,
              port2=role.power_input,
            )
      [1]:
        metadata:
          pins:
            4: choice(
              supply_12v,
              port0=role.power_input,
              port1=role.power_output,
              port2=role.power_input,
            )
            7: choice(
              supply_12v,
              port0=role.power_input,
              port1=role.passive,
              port2=role.power_input,
            )
      [2]:
        metadata:
          pins:
            4: choice(
              supply_12v,
              port0=role.power_input,
              port1=role.power_input,
              port2=role.power_output,
            )
            7: choice(
              supply_12v,
              port0=role.power_input,
              port1=role.power_input,
              port2=role.passive,
            )

  inst i2c_pullups[2]: I2CPullup
    [0]."1": sda
    [1]."1": scl
    "2": vcc
    params:
      value: 2k

  inst buck_input_caps[2]: Cap0805(v5, gnd, value=10u)
