// Adapted from Jeremy Elson / rulos, 6-Line Matrix Rev B. See README.md.
// Preserve source connectivity, including unused nets and unspecified values.
from noscheme import net, role
import matrix
from interfaces import Rows, LocalI2C, BufferedI2C
from display import TwoColumns
from components import Buck, Cap0603, Cap0805, BuckOutputCap, CortexHeader, Header2, Header3, I2CBuffer, I2CPullup, BuckOutputInductor, MCU, PChannel, PowerJack, RJ45, LogicRegulator, BusRegulator, BusOutputCap, Resistor

board SixLineMatrix:
  // ERC checks every combination of the two supply choices.
  metadata:
    erc_choices:
      supply_5v: ["jack", "header"]
      supply_12v: ["port0", "port1", "port2"]
  net.digital blank#, clock, latch, rx, swclk, tx
  // Switching/feedback nodes retain passive compatibility for this first pass.
  net.passive bootstrap, feedback, switch_node
  net.ground gnd:
    voltage: 0..0
  net.open_drain reset#
  net.bidirectional swdio
  LocalI2C scl, sda:
    wiring_capacitance: 50p
    voltage: 0..3.465
  BufferedI2C scl_hv, sda_hv:
    wiring_capacitance: 100p
  // Supply voltages are assumed steady-state envelopes, not a regulator simulation.
  // BuckOutputInductor explicitly models the converter output at pad 2.
  net.power led_power:
    checks:
      // 64 shared sinks, not 6 independent full-row loads.
      // 20mA matches the 1k R_EXT selection; 10% is a design allowance.
      // Extra 1mA covers feedback-divider current and steady leakage.
      display_load: matrix.shared_sink_budget(load=64 * 20m * 1.10 + 1m)
    voltage: 2.5 ± 5%
  net.power v10:
    voltage: 10 ± 5%
  net.power v12:
    voltage: 12 ± 5%
  net.power v5:
    voltage: 5 ± 5%
  net.power vcc:
    voltage: 3.3 ± 5%
  Rows rows
  net.digital row_enable[6]
  net.digital serial_data[5]

  // Four modules share controls and row buses. Slices form the serial chain.
  TwoColumns banks[4](
    rows: rows,
    supply: vcc,
    ground: gnd,
    clock: clock,
    latch: latch,
    blank: blank#,
    sdi: serial_data[0:4],
    sdo: serial_data[1:5],
  )

  MCU<"STM32F303K8T6"> mcu:
    ["1", "17", "5"]: vcc
    "10": row_enable[4]
    "11": row_enable[5]
    "12": blank#
    "13": latch
    ["14", "15", "18", "2", "21", "22", "25", "27", "3"]: no_connect
    ["16", "31", "32"]: gnd
    "19": tx
    "20": rx
    "23": swdio
    "24": swclk
    "26": clock
    "28": serial_data[0]
    "29": scl
    "30": sda
    "4": reset#
    "6": row_enable[0]
    "7": row_enable[1]
    "8": row_enable[2]
    "9": row_enable[3]

  Header2<"22-23-2021"> power_header:
    1: v5
    2: gnd
    metadata:
      pins:
        1: choice(supply_5v, jack=role.power_input, header=role.power_output)
        2: role.ground

  LogicRegulator logic_regulator(1: gnd, 2: vcc, 3: v5)

  BusRegulator bus_regulator(1: v12, 2: gnd, 3: v10)

  CortexHeader<"CORTEX_HEADERJ"> debug:
    "1": vcc
    "10": reset#
    "2": swdio
    ["3", "5", "9"]: gnd
    "4": swclk
    // PB3 is used for the LED clock, so trace output is unavailable.
    ["6", "7", "8"]: no_connect
    metadata:
      // Roles describe the attached debug probe, not the MCU.
      pins:
        1: role.power_input
        [3, 5, 9]: role.ground
        2: role.digital_bidirectional
        4: role.digital_output
        6: role.digital_input
        10: role.open_drain

  I2CBuffer<"PCA9600SO8"> bus_buffer:
    "1": sda
    ["2", "3"]: sda_hv
    "4": gnd
    ["5", "6"]: scl_hv
    "7": scl
    "8": v10

  Header3<"22-23-2031"> uart:
    1: tx
    2: rx
    3: gnd
    metadata:
      // External UART adapter receives TX and drives RX.
      pins:
        1: role.digital_input
        2: role.digital_output
        3: role.ground

  BuckOutputInductor<2.2u> inductor(1: switch_node, 2: led_power)

  Resistor<22.6k> feedback_top(feedback, led_power)

  Resistor<10k> feedback_bottom(gnd, feedback)

  Buck<"TPS563200"> buck:
    "1": gnd
    "2": switch_node
    ["3", "5"]: v5
    "4": feedback
    "6": bootstrap

  PowerJack<"PJ-036AH-SMT-TR"> power_jack:
    PWR: v5
    GND: gnd
    GNDBREAK: no_connect
    metadata:
      pins:
        PWR: choice(supply_5v, jack=role.power_output, header=role.power_input)
        GND: role.ground

  Cap0805<10u> cap_1(v5, gnd)

  Cap0805<4.7u> cap_2(vcc, gnd)

  Cap0603<1u> cap_3(v12, gnd)

  BusOutputCap cap_4(1: v10, 2: gnd)

  Cap0603<1u> cap_5(vcc, gnd)

  BuckOutputCap cap_8(1: led_power, 2: gnd)

  BuckOutputCap cap_9(1: led_power, 2: gnd)

  Cap0603<100n> cap_10(switch_node, bootstrap)

  PChannel<"MOSFET-PCHANNEL"> row_switch[6]:
    G: row_enable
    "2": led_power
    [0]."3": rows.row0
    [1]."3": rows.row1
    [2]."3": rows.row2
    [3]."3": rows.row3
    [4]."3": rows.row4
    [5]."3": rows.row5

  RJ45<"54602-908LF"> bus_ports[3]:
    1: sda_hv
    [2, 5, 6, 8]: gnd
    3: scl_hv
    [4, 7]: v12
    metadata:
      pins:
        [1, 3]:
          role: role.open_drain
          // Per port, per signal: connector + cable + downstream devices.
          // All three branches count simultaneously; see README.
          capacitance: 1n
        [2, 5, 6, 8]: role.ground
    // Pins 4 and 7 carry the same external supply. Count it once, at pin 4;
    // the selected source's pin 7 is a passive parallel contact.
    elements:
      [0]:
        metadata:
          pins:
            4: choice(
              supply_12v,
              port0=role.power_output,
              port1=role.power_input,
              port2=role.power_input,
            )
            7: choice(
              supply_12v,
              port0=role.passive,
              port1=role.power_input,
              port2=role.power_input,
            )
      [1]:
        metadata:
          pins:
            4: choice(
              supply_12v,
              port0=role.power_input,
              port1=role.power_output,
              port2=role.power_input,
            )
            7: choice(
              supply_12v,
              port0=role.power_input,
              port1=role.passive,
              port2=role.power_input,
            )
      [2]:
        metadata:
          pins:
            4: choice(
              supply_12v,
              port0=role.power_input,
              port1=role.power_input,
              port2=role.power_output,
            )
            7: choice(
              supply_12v,
              port0=role.power_input,
              port1=role.power_input,
              port2=role.passive,
            )

  I2CPullup<2k> i2c_pullups[2]:
    [0]."1": sda
    [1]."1": scl
    "2": vcc

  Cap0805<10u> buck_input_caps[2](v5, gnd)
