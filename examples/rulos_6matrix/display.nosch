// Adapted from Jeremy Elson / rulos. See README.md.
from noscheme import net, unused, role
from components import Display, SinkDriver, Resistor, Cap0603
from interfaces import Rows, Segments

// One column: six digits share segment cathodes; each row has its own anode.
block Column:
  ports:
    Rows rows
    Segments segments
  Display digits[6]:
    A: segments.a
    B: segments.b
    C: segments.c
    D: segments.d
    E: segments.e
    F: segments.f
    G: segments.g
    DP: segments.dp
    [0].[3, 8]: rows.row0
    [1].[3, 8]: rows.row1
    [2].[3, 8]: rows.row2
    [3].[3, 8]: rows.row3
    [4].[3, 8]: rows.row4
    [5].[3, 8]: rows.row5

// Corresponds to the original Eagle module 2COL-7SEG.
block TwoColumns:
  ports:
    Rows rows
    net.power supply:
      role: role.power_input
    net.ground ground:
      role: role.ground
    net.digital sdi:
      role: role.digital_input
    net.digital sdo:
      role: role.digital_output
      unused: unused.always
    net.digital clock:
      role: role.digital_input
    net.digital latch:
      role: role.digital_input
    net.digital blank:
      role: role.digital_input
  Segments left_segments
  Segments right_segments
  net.passive current_set
  Column left(rows: rows, segments: left_segments)
  Column right(rows: rows, segments: right_segments)
  SinkDriver driver(
    VCC: supply,
    GND: ground,
    EP: ground,
    SDI: sdi,
    SDO: sdo,
    CLK: clock,
    LE: latch,
    OE: blank,
    R_EXT: current_set,
    OUT0: left_segments.a,
    OUT1: left_segments.b,
    OUT2: left_segments.c,
    OUT3: left_segments.d,
    OUT4: left_segments.e,
    OUT5: left_segments.f,
    OUT6: left_segments.g,
    OUT7: left_segments.dp,
    OUT8: right_segments.a,
    OUT9: right_segments.b,
    OUT10: right_segments.c,
    OUT11: right_segments.d,
    OUT12: right_segments.e,
    OUT13: right_segments.f,
    OUT14: right_segments.g,
    OUT15: right_segments.dp,
  )
  // 1k sets approximately 20mA: 80% of the Inolux 25mA continuous rating.
  // See README for temperature, multiplexing, and voltage-headroom limits.
  Resistor<1k> current_resistor(ground, current_set)
  Cap0603<1u> bypass(supply, ground)
