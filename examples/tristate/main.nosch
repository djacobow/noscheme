// Electrical example: capability checking does not verify bus arbitration.
from noscheme import role, net, use

component Transceiver:
  pins:
    data:
      role: role.digital_bidirectional
      tristate_capable: true
      use: use.required

component Receiver:
  pins:
    data: [role.digital_input, use.required]

block SharedBus:
  net.tristate data
  Transceiver devices[2](data: data)
  Receiver receiver(data: data)
