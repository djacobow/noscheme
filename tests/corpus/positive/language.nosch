from noscheme import role, net, unused, f, num

component Part:
    params:
        number count = 2
        string value
    pins:
        1..20:
            unused: unused.explicit
        01 (extra, "EP-1"):
        A1:
            role: role.passive
    metadata:
        custom:
            url: "https://example.invalid/*not a comment*/"

extend Part<value: f.kOhm(4.7)> Specialized

bundle Parallel:
    net.digital data[4]

block Block:
    ports:
        Parallel bus[2]:
            placeholder: true

board Test:
    global net.ground #ground
    net.digital signal#[2][4]
    Parallel values[2]
    Specialized<count: num.int(4 / 2) + (1 << 2) - (8 >> 1)> parts[2][4]:
        [0][1].A1: signal#[0][1]
        1..4: signal#[0:2]
        extra: no_connect
        params:
            value: "{value:.1f}".format(3e0)
        metadata:
            pins:
                1..20:
                    external_role: role.digital_input
    Block blocks[2]:
        [0].bus[1].data[2]: signal#[0][0]
// Parsing does not imply this fixture is electrically or shape-valid.
