// Production front-end syntax. Metadata schemas and name resolution are separate.
start: _NL* (import_stmt | definition)*
import_stmt: "from" name_path "import" imported_name ("," imported_name)* _NL
           | "import" name_path _NL
imported_name: NAME ["as" NAME]
definition: definition_kind NAME extends? ":" _NL _INDENT definition_item+ _DEDENT
definition_kind: "component" -> component_kind
               | "block" -> block_kind
               | "board" -> board_kind
               | "bundle" -> bundle_kind
               | "nettype" -> nettype_kind
extends: "extends" name_path
?definition_item: instance | net_decl | section | field
section: section_name ":" _NL _INDENT field+ _DEDENT
// Prefer definition sections where a section and a field could both parse.
section_name.1: PARAMS -> params_name
            | "defaults" -> defaults_name
            | PINS -> pins_name
            | "ports" -> ports_name
            | "metadata" -> metadata_name
// Metadata field schemas are validated during resolution.
field: (field_key | aliased_key) ":" [field_value ["=" expr]] _NL [_INDENT field+ _DEDENT]
// Ranges and tolerances are field values only: `voltage: 4.75..5.25`, `voltage: 5 ± 5%`.
?field_value: expr
            | expr ".." expr -> range_value
            | expr TOLERANCE expr [PERCENT] -> tolerance_value
?field_key: plain_field_key | index -> single_pin_list
// A pin declaration may name its aliases: `1 (cathode, K): role.passive`.
aliased_key: pin_key _LPAR pin_key ("," pin_key)* [","] _RPAR
plain_field_key: pin_key [".." pin_key] -> field_key
               | _LSQB pin_group _RSQB -> field_key
// Singleton lists share the index syntax to keep leading instance selectors
// such as [0].pin unambiguous. Multi-key/range lists diverge at ',' or '..'.
pin_group: pin_key ".." pin_key ("," pin_selection)* [","] -> range_group
         | pin_key "," [pin_selection ("," pin_selection)* [","]] -> list_group
pin_selection: pin_key [".." pin_key]
// pins is also a metadata key, including after nested sibling mappings.
?pin_key: NAME | INT | STRING | PINS | PARAMS
net_decl: global_modifier? "net" NAME ("," NAME)* ":" expr _NL [_INDENT field+ _DEDENT]
global_modifier: "global"
// Parentheses hold arguments: positional nets for interchangeable pins, pin: net,
// param=value, and `*` for same-name connections. The indented body holds connections,
// then params, metadata, and elements sections; both may be used together.
instance: "inst" NAME index* ":" name_path [_LPAR [inline_arguments] _RPAR] _NL [_INDENT _instance_body _DEDENT]
inline_arguments: inline_argument ("," inline_argument)* [","]
?inline_argument: target -> positional_argument
                | (NAME | INT | STRING) ":" target -> inline_binding
                | NAME "=" expr -> inline_parameter
                | MUL -> wildcard_argument
_instance_body: binding+ inst_section* | inst_section+
?inst_section: arguments | instance_metadata | elements
elements: "elements" ":" _NL _INDENT element_override+ _DEDENT
element_override: index+ ":" _NL _INDENT element_section+ _DEDENT
?element_section: arguments | instance_metadata
binding: endpoint ":" target _NL
// Section words start sections here; quote a pin with such a name: "params": net.
?endpoint: binding_key endpoint_suffix* | index+ "." field_key endpoint_suffix*
         | index -> singleton_endpoint
binding_key: (NAME | INT | STRING | PINS) [".." (NAME | INT | STRING | PINS)] -> field_key
           | _LSQB pin_group _RSQB -> field_key
?endpoint_suffix: "." NAME | index
// flat(net) binds an array net's elements in row-major order.
?target: reference
       | NAME _LPAR reference _RPAR -> call_target
arguments: "params" ":" _NL _INDENT argument+ _DEDENT
argument: NAME ":" expr _NL
instance_metadata: "metadata" ":" _NL _INDENT field+ _DEDENT

?expr: shift
?shift: sum (SHIFT sum)*
?sum: product (ADD product)*
?product: unary (MUL unary)*
?unary: ADD unary -> unary
      | postfix
?postfix: atom postfix_suffix*
?atom: SCALED -> scaled
     | NUMBER -> number
     | INT -> integer
     | STRING -> string
     | NAME -> name
     | PINS -> name
     | _LPAR expr _RPAR -> grouped
     | _LSQB [expr ("," expr)* [","]] _RSQB -> list_value
?postfix_suffix: "." NAME -> member
               | index
               | _LPAR [call_argument ("," call_argument)* [","]] _RPAR -> call
?call_argument: NAME "=" expr -> keyword_argument
              | expr
reference: NAME ("." NAME | index)*
index: _LSQB expr [":" expr] _RSQB
name_path: NAME ("." NAME)*

SHIFT: "<<" | ">>"
TOLERANCE: "±" | "+/-"
PERCENT: "%"
PINS: "pins"
PARAMS: "params"
ADD: "+" | "-"
MUL: "*" | "/"
// SI-prefixed literals: 4.7k, 4k7, 100n, 4R7. A following name character is not a suffix.
SCALED.3: /[0-9]+(?:\.[0-9]+)?[afpnumkMGTPR](?:[0-9]+)?(?![A-Za-z0-9_#])/
NUMBER.2: /(?:[0-9]+\.[0-9]+(?:[eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+)/
INT: /[0-9]+/
NAME: /[A-Za-z_#][A-Za-z0-9_#]*/
STRING: /"(?:[^"\\\r\n]|\\[^\r\n])*"/
_LPAR: "("
_RPAR: ")"
_LSQB: "["
_RSQB: "]"
_NL: /(\r?\n[\t ]*)+/
%import common.WS_INLINE
%ignore WS_INLINE
%declare _INDENT _DEDENT
