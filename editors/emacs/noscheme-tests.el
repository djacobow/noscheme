(require 'ert)
(require 'noscheme-eglot)
(require 'flymake)
(require 'xref)
(require 'bytecomp)

(defun noscheme-test--wait (predicate)
  "Wait at most 20 seconds for PREDICATE, processing server messages."
  (let ((deadline (+ (float-time) 20)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.05))
    (should (funcall predicate))))

(ert-deftest noscheme-byte-compiles ()
  (let ((byte-compile-error-on-warn t)
        (byte-compile-dest-file-function
         (lambda (file)
           (expand-file-name (concat (file-name-nondirectory file) "c")
                             (getenv "NOSCHEME_EMACS_TEST_ROOT")))))
    (dolist (name '("noscheme-mode.el" "noscheme-eglot.el"))
      (should (byte-compile-file
               (expand-file-name (concat "editors/emacs/" name)
                                 noscheme-eglot--checkout))))))

(ert-deftest noscheme-numeric-literal-highlighting ()
  (with-temp-buffer
    (let ((noscheme-mode-hook nil)) (noscheme-mode))
    (dolist (literal '("0xFF_FF" "0b1010_0011" "1_000" ".5" ".5µ" "1µ5"))
      (erase-buffer)
      (insert "number value = " literal "\n")
      (font-lock-ensure)
      (goto-char (point-min))
      (search-forward literal)
      (should (eq (get-text-property (- (point) (length literal)) 'face)
                  'font-lock-constant-face)))))

(ert-deftest noscheme-syntax-and-indentation ()
  (with-temp-buffer
    (let ((noscheme-mode-hook nil)) (noscheme-mode))
    (insert "block B:\nnet.digital #reset // comment\n/* outer /* inner */ global\n")
    (goto-char (point-min))
    (forward-line)
    (indent-according-to-mode)
    (should (= (current-indentation) 2))
    (search-forward "#reset")
    (should (equal (thing-at-point 'symbol t) "#reset"))
    (search-forward "comment")
    (should (nth 4 (syntax-ppss)))
    (search-forward "global")
    (should-not (nth 4 (syntax-ppss)))
    (font-lock-ensure)
    (should (eq (get-text-property (- (point) 2) 'face) 'font-lock-keyword-face))
    (should (equal comment-start "// "))
    (should-not indent-tabs-mode)
    (goto-char (point-min))
    (forward-line)
    (noscheme-dedent-line)
    (should (= (current-indentation) 0))))

(ert-deftest noscheme-project-discovery ()
  (let ((root (getenv "NOSCHEME_EMACS_TEST_ROOT")))
    (with-temp-buffer
      (let ((noscheme-mode-hook nil)) (noscheme-mode))
      (should (equal (project-root (project-current nil (expand-file-name "one/" root)))
                     (expand-file-name "one/" root)))
      (should (equal (project-root (project-current nil (expand-file-name "two/" root)))
                     (expand-file-name "two/" root))))
    (with-temp-buffer
      (fundamental-mode)
      (should-not (noscheme-eglot--project root)))))

(ert-deftest noscheme-real-eglot-session ()
  (let* ((root (expand-file-name "one/" (getenv "NOSCHEME_EMACS_TEST_ROOT")))
         (noscheme-eglot-server-command
          (json-parse-string (getenv "NOSCHEME_EMACS_TEST_COMMAND") :array-type 'list))
         (eglot-sync-connect t)
         (eglot-connect-timeout 20)
         (eglot-autoshutdown t)
         (eglot-send-changes-idle-time 0.01)
         (buffer (find-file-noselect (expand-file-name "main.nosch" root)))
         server)
    (unwind-protect
        (with-current-buffer buffer
          (should (eq major-mode 'noscheme-mode))
          ;; Emulate the editor's command loop: eglot-ensure starts here.
          (run-hooks 'post-command-hook)
          (noscheme-test--wait (lambda () (eglot-managed-p)))
          (setq server (eglot-current-server))
          (should (member #'eglot-completion-at-point completion-at-point-functions))
          (should (member #'eglot-hover-eldoc-function eldoc-documentation-functions))
          (flymake-start)
          (noscheme-test--wait
           (lambda ()
             (cl-some (lambda (d) (string-match-p "spare.1" (flymake-diagnostic-text d)))
                      (flymake-diagnostics))))
          (let ((diagnostic
                 (cl-find-if (lambda (d) (string-match-p "spare.1" (flymake-diagnostic-text d)))
                             (flymake-diagnostics))))
            (goto-char (flymake-diagnostic-beg diagnostic))
            (should (looking-at-p "C spare")))
          (goto-char (point-min))
          (search-forward "C cap")
          (backward-char 5)
          (let* ((id (xref-backend-identifier-at-point 'eglot))
                 (definitions (xref-backend-definitions 'eglot id))
                 (location (xref-item-location (car definitions))))
            (should (string-suffix-p "parts.nosch" (xref-file-location-file location))))
          (let (hover)
            (eglot-hover-eldoc-function (lambda (text &rest _) (setq hover text)))
            (noscheme-test--wait (lambda () hover))
            (should (string-match-p "Capacitor" hover)))
          (goto-char (point-min))
          (search-forward "wire")
          (backward-char 2)
          (eglot-rename "trace")
          (should (string-match-p "net.passive trace" (buffer-string)))
          (should (string-match-p "1: trace, 2: trace" (buffer-string)))
          (should-not (string-match-p "wire" (buffer-string)))
          (goto-char (point-min))
          (while (re-search-forward "^  " nil t)
            (replace-match "    "))
          (eglot-format-buffer)
          (should (string-match-p "\n  net.passive trace\n" (buffer-string)))
          (let ((valid (buffer-string)))
            (dolist (case '(("C<" "value") ("C<100n> extra(" "1")
                            ("C<100n> extra(1: trace," "2")))
              (erase-buffer)
              (insert valid "  " (car case))
              (eglot--signal-textDocument/didChange)
              (let* ((capf (eglot-completion-at-point))
                     (choices (all-completions "" (nth 2 capf))))
                (should (member (cadr case) (mapcar #'substring-no-properties choices)))))
            (erase-buffer)
            (insert valid))
          ;; Edits were all unsaved: Emacs sent didChange to the server.
          (should (buffer-modified-p)))
      (when server
        (with-current-buffer buffer (eglot-shutdown server)))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer (set-buffer-modified-p nil))
        (kill-buffer buffer)))))

